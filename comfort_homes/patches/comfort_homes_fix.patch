ame,\n    {\n        \"director_name\":\n            director_name,\n\n        \"director_signature\":\n            signature_value,\n\n        \"director_signed_on\":\n            signed_on,\n\n        \"status\":\n            \"Director Signed\"\n    }\n)\n\n\n# ============================================================\n# RELOAD LOAN APPLICATION\n# ============================================================\n\ndoc = frappe.get_doc(\n    \"Loan Application\",\n    docname\n)\n\n\n# ============================================================\n# VALUES REQUIRED BY PRINT FORMAT\n# ============================================================\n\ndoc.hp_account_no = (\n    doc.custom_flexi_hp_account_number\n    or doc.name\n)\n\ndoc.hp_reference_no = (\n    doc.custom_flexi_quotation_number\n    or \"\"\n)\n\ndoc.hirer_signature = (\n    doc.custom_applicant_signature\n    or agreement.customer_signature\n    or \"\"\n)\n\ndoc.hirer_signature_date = (\n    doc.custom_flexi_hirer_signature_date\n    or agreement.customer_signed_on\n)\n\ndoc.company_representative_name = (\n    director_name\n)\n\ndoc.company_representative_signature = (\n    signature_value\n)\n\ndoc.company_representative_date = (\n    signed_date\n)\n\n\n# ============================================================\n# RENDER FINAL AGREEMENT\n#\n# This contains BOTH:\n# customer signature\n# director signature\n# ============================================================\n\nhtml = frappe.get_print(\n    \"Loan Application\",\n    doc.name,\n    print_format=\"Hire Purchase Agreement\",\n    doc=doc\n)\n\n\nif not html:\n    frappe.throw(\n        \"Final signed agreement could not be rendered.\"\n    )\n\n\n# ============================================================\n# CREATE FINAL SIGNED HTML ATTACHMENT\n#\n# wkhtmltopdf is unavailable on this server,\n# therefore we intentionally store the exact signed HTML.\n# ============================================================\n\nfile_name = (\n 