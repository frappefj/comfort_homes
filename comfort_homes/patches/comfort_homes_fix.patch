height: 1.15;\n  letter-spacing: .02em; text-transform: uppercase; margin: 4pt 0 3pt;\n}\n.cira-authority-form h3 { text-align: center; margin-bottom: 7pt; }\n.subtitle, .info-header p { font-size: 9.5pt; font-weight: normal; font-style: italic; margin: 2pt 0 0; line-height: 1.2; }\n.dbl { border: 0; border-top: .6pt solid #000; height: 0; margin-top: 5pt; }\n.hp-header, .info-header { border-bottom: .6pt solid #000; padding-bottom: 5pt; }\n/* Metadata and narrative layouts are borderless. Original HTML remains intact. */\n.kv, .refbox, .hp-meta-table { table-layout: fixed; border: 0; margin: 4pt 0 6pt; }\n.kv td, .refbox td, .hp-meta-table td { border: 0; background: transparent; padding: 2pt 4pt; }\n.kv .l { width: 30%; font-weight: normal; background: transparent; }\n.kv .v, .refbox .rv { font-weight: bold; }\n.refbox .rl { display: block; font-size: 9pt; font-style: italic; }\n.refbox .rv { display: block; font-size: 10pt; min-height: 12pt; }\n.hp-meta-table td:first-child { width: 15% !important; }\n.hp-meta-table td:nth-child(2) { width: 42% !important; }\n.hp-meta-table td:nth-child(3) { width: 18% !important; }\n.hp-meta-table td:nth-child(4) { width: 25% !important; }\n/* Only goods and financial details receive restrained rules. */\n.key, .key-terms, .fin, .goods, .hp-data-table {\n  width: 100%; border-collapse: collapse; margin: 5pt 0 7pt; border: .5pt solid #888;\n  font-size: 10pt; line-height: 1.2;\n}\n.key, .key-terms, .fin, .goods { table-layout: fixed; }\n.key, .key-terms { page-break-inside: avoid; }\n.key th, .key-terms th, .goods th, .hp-data-table th {\n  font-size: 9.5pt; background: #eee; color: #000; font-weight: bold;\n  text-align: left; padding: 3pt 4pt; border: .5pt solid #888;\n}\n.key td, .key-terms td { padding: 4pt; border-right: .5pt solid #888; vertical-align: top; }\n.k-label { font-size: 9pt; font-style: italic; line-height: 1.15; margin-bottom: 2pt; }\n.k-val { font-size: 10.5pt; font-weight: bold; line-height: 1.2; white-space: normal; overflow-wrap: break-word; }\n.k-sub { font-size: 9pt; font-style: italic; margin-top: 1pt; }\n.fin td, .goods td, .hp-data-table td { padding: 2.5pt 4pt; border: .5pt solid #aaa; }\n.fin .r { width: 10mm; font-weight: bold; text-align: center; white-space: nowrap; }\n.fin .cur { width: 7mm; text-align: right; padding-right: 2pt; border-right: 0; }\n.fin .amt { width: 32mm; text-align: right; font-weight: bold; white-space: nowrap; border-left: 0; }\n.fin tr.strong td { border-top: 1pt solid #000; background: #eee; font-weight: bold; }\n.fin tr.hl td { background: #f3f3f3; font-weight: bold; }\n/* Core table setup to ensure thin, crisp borders */\n.goods, {\n  border-collapse: collapse;\n}\n.goods th, .goods td {\n  border: 1px solid #cccccc; /* Use #cccccc for a subtle, softer grey look */\n}\n.goods .no { width: 10mm; text-align: center; }\n.goods .q { width: 14mm; text-align: center; }\n.goods .p { width: 30mm; text-align: right; white-space: nowrap; }\n.goods td { height: 15pt; }\n.hp-data-table td, .hp-data-table th { color: #000 !important; }\n.hp-data-table tr[style] { background-color: #f3f3f3 !important; }\n/* Compact narrative sections with hanging numbers; no flex/grid dependency. */\n.sec, .section-category {\n  font-size: 10pt; font-weight: bold; text-transform: uppercase; letter-spacing: .02em;\n  text-align: left; margin: 8pt 0 4pt; padding: 0 0 2pt; border: 0;\n  border-bottom: .5pt solid #777; background: transparent;\n}\n.lead { font-size: 10pt !important; line-height: 1.25; margin: 0 0 5pt; }\n.cl { font-size: 10pt !important; margin: 0 0 4pt; padding-left: 9mm; position: relative; page-break-inside: auto; }\n.cl .n { position: absolute; left: 0; top: 0; width: 8mm; font-weight: bold; }\n.cl .h { font-weight: bold; margin-bottom: 2pt; }\n.cl p { margin: 0 0 3pt; text-align: left; }\n.cl ul { margin: 2pt 0 3pt; padding-left: 14pt; }\n.cl li { margin-bottom: 2pt; text-align: left; }\n.sub { padding-left: 7mm; margin: 0 0 3pt; text-align: left; }\n.qa-block { display: block; position: relative; padding-left: 7mm; margin-bottom: 6pt; page-break-inside: auto; break-inside: auto; }\n.qa-number { position: absolute; left: 0; top: 0; width: 6mm; font-size: 10pt; font-weight: bold; }\n.qa-content { display: block; }\n.qa-question { font-size: 10pt; font-weight: bold; margin-bottom: 2pt; }\n.qa-answer { text-align: left; orphans: 3; widows: 3; }\n.qa-answer ul { margin: 3pt 0; padding-left: 16pt; }\n.hp-legal-clauses { font-size: 10pt; line-height: 1.2; text-align: left; margin-top: 6pt; padding-top: 4pt; border-top: .5pt solid #777; }\n.hp-clause { display: block; position: relative; padding-left: 7mm; margin-bottom: 4pt; orphans: 3; widows: 3; }\n.hp-clause-num { position: absolute; left: 0; top: 0; width: 6mm; font-weight: bold; }\n.hp-clause-text { display: block; }\n/* Legal warning emphasis is retained; not treated as a layout border. */\n.notice { border: 2.25pt solid #000; padding: 7pt 10pt; margin: 8pt 0; text-align: center; font-weight: bold; page-break-inside: avoid; }\n.notice .nt { font-size: 11pt; letter-spacing: .04em; margin-bottom: 4pt; }\n.notice-soft { border: 1.5pt solid #000; padding: 6pt 10pt; margin: 8pt 0; page-break-inside: avoid; }\n.notice-soft .nt { font-weight: bold; text-align: center; margin-bottom: 4pt; border-bottom: .75pt solid #000; padding-bottom: 3pt; }\n.notice-soft p { margin-bottom: 3pt; }\n.hp-notice-box, .statutory-notice-box {\n  border: 1.5px solid #000; background: #fafafa; padding: 7pt 9pt;\n  margin: 8pt 0; font-size: 10pt; line-height: 1.25; page-break-inside: avoid; break-inside: avoid;\n}\n.statutory-notice-box strong { display: block; margin-bottom: 3pt; }\n/* Preserve intentional execution-page breaks pending legal/operational approval. */\n.hp-page-two-container { page-break-before: always; margin-top: 0; }\n.pagebreak, .page-break { page-break-before: always; break-before: page; }\n/* Signature areas remain usable on paper; no content is conditionally hidden. */\n.sign { table-layout: fixed; margin-top: 8pt; page-break-inside: avoid; }\n.sign td { padding: 0 10pt 0 0; vertical-align: top; border: 0; }\n.sign td:last-child { padding-right: 0; }\n.sign .who { font-weight: bold; text-transform: uppercase; font-size: 9.5pt; letter-spacing: .02em; margin-bottom: 3pt; }\n.sign .box { height: 20mm; border-bottom: .75pt solid #000; }\n.sign .cap { font-size: 9pt; font-style: italic; margin-top: 2pt; }\n.sign .line { margin-top: 4pt; border-bottom: .5pt solid #888; padding-bottom: 1pt; min-height: 13pt; }\n.sign .line span { font-size: 9pt; font-style: italic; }\n.sig-img { max-width: 100%; max-height: 18mm; display: block; }\n.signature-container, .hp-signature-block { margin-top: 8pt; width: 100%; page-break-inside: auto; break-inside: auto; }\n.ack-meta-panel { margin-top: 6pt; font-size: 10pt; line-height: 1.25; page-break-inside: avoid; }\n.signature-grid, .hp-sig-grid { display: block; width: 100%; margin-top: 3pt; }\n.signature-block, .hp-sig-cell {\n  display: inline-block; width: 47%; margin: 5pt 2% 5pt 0;\n  padding-top: 17mm; vertical-align: top; position: relative;\n  border: 0; font-size: 10pt; line-height: 1.25; page-break-inside: avoid; break-inside: avoid;\n}\n.signature-block:before, .hp-sig-cell:before {\n  content: \"\"; position: absolute; left: 0; right: 0; top: 16mm; border-top: .75pt solid #000;\n}\n.sig-image, .hp-sig-img { position: absolute; top: 0; bottom: auto; left: 0; max-width: 100%; max-height: 15mm; }\n.block, .avoid { page-break-inside: avoid; }\nhr { border: 0; border-top: .5pt solid #777; margin: 7pt 0; }\n.cira-authority-form p { margin-bottom: 5pt; }\n.cira-authority-form ~ img { max-width: 62mm !important; max-height: 20mm !important; }\n@media print {\n  @page { size: A4; margin: 12mm; }\n  body, .print-format { background: #fff; }\n  thead { display: table-header-group; }\n  tfoot { display: table-footer-group; }\n}\n\n</style>\n{# ===== shared setup - identical in all six formats ===== #}\n{% macro money(v) %}{{ \"{:,.2f}\".format((v or 0)|float) }}{% endmacro %}\n{% set period_label = doc.custom_flexi_payment_period or \"Monthly\" %}\n{% set period_key = period_label|lower|replace(\"-\", \"\")|replace(\" \", \"\") %}\n{% set count_map = {\"weekly\": doc.custom_flexi_weekly_instalments, \"fortnightly\": doc.custom_flexi_fortnightly_instalments, \"bimonthly\": doc.custom_flexi_bimonthly_instalments, \"monthly\": doc.custom_flexi_monthly_instalments} %}\n{% set amount_map = {\"weekly\": doc.custom_flexi_weekly_instalment_amount, \"fortnightly\": doc.custom_flexi_fortnightly_instalment_amount, \"bimonthly\": doc.custom_flexi_bimonthly_instalment_amount, \"monthly\": doc.custom_flexi_monthly_instalment_amount} %}\n{% set n_instalments = count_map.get(period_key) or doc.repayment_periods or \"\" %}\n{% set instalment_amount = amount_map.get(period_key) or doc.repayment_amount or 0 %}\n{% set addr_parts = [doc.address_line_1, (doc.address_line_2 if doc.address_line_2 != doc.address_line_1 else none), (doc.custom_suburb or doc.suburb), doc.city, (doc.custom_province if doc.custom_province != doc.city else none), doc.country, (doc.zip_code if doc.zip_code and doc.zip_code != 0 else none)] %}\n{% set address = addr_parts|select|join(\", \") %}\n{% set items = doc.custom_flexi_purchase_items or [] %}\n{% set office = doc.company_registered_office or \"Lot 18 Yarawa Road, Nabua, Suva, Central Division, Fiji\" %}\n{% set hirer_signature = doc.hirer_signature or doc.custom_applicant_signature or \"\" %}\n{% set hirer_date = doc.hirer_signature_date or doc.custom_flexi_hirer_signature_date or \"\" %}\n{% set rep_name = doc.company_representative_name or doc.custom_flexi_company_representative_name or \"\" %}\n{% set rep_signature = doc.company_representative_signature or doc.custom_flexi_company_representative_signature or \"\" %}\n{% set rep_date = doc.company_representative_date or doc.custom_flexi_company_representative_date or \"\" %}\n{% set co_applicants = get_co_applicants(doc.name) %}\n{% set has_co_applicants = co_applicants|length > 0 %}\n{# Print-only joint name: reuse the co-applicant list already retrieved above. #}\n{% set joint = namespace(name=(doc.applicant_name or '')) %}\n{% if has_co_applicants %}\n    {% for co_applicant in co_applicants %}\n        {% set co_name = applicant_name(co_applicant) %}\n        {% if co_name %}\n            {% set joint.name = joint.name ~ (' & ' if joint.name else '') ~ co_name %}\n        {% endif %}\n    {% endfor %}\n{% endif %}\n{% set hirer_names = joint.name %}\n<div class=\"head\">\n<div class=\"org\">Comfort Home Furnishing Pte Limited</div>\n<div class=\"org2\">trading as Flexible Purchase</div>\n<div class=\"title\">Form 2: Consent to enter premises</div>\n\n<div class=\"dbl\"></div>\n</div>\n\n<table class=\"kv\">\n<tr>\n    <td class=\"l\">Date</td>\n    <td class=\"v\">\n        {% set consent_date = doc.form2_date or doc.custom_flexi_form2_date or frappe.utils.nowdate() %}\n        {{ frappe.utils.formatdate(consent_date, \"dd-MM-yyyy\") }}\n    </td>\n</tr>\n<tr><td class=\"l\">To</td><td class=\"v\">COMFORT HOME FURNISHING PTE LIMITED TRADING AS FLEXIBLE PURCHASE</td></tr>\n<tr><td class=\"l\">From <span style=\"font-weight:normal;\">(name of occupier)</span></td><td class=\"v\">{{ hirer_names }}</td></tr>\n<tr><td class=\"l\">Address</td><td class=\"v\">{{ address }}</td></tr>\n</table>\n<p style=\"margin-top:12pt;\">I give consent to the credit provider or its agent to enter the premises to take possession of the mortgaged goods described below.</p>\n<div class=\"sec\">The mortgaged goods are</div>\n\n<table class=\"goods\">\n  <thead>\n    <tr>\n      <th class=\"no\">No.</th>\n      <th>Description</th>\n      <th class=\"q\">Qty</th>\n      <th class=\"p\">Price</th>\n    </tr>\n  </thead>\n  <tbody>\n    {# This loop now completely dictates the table height #}\n    {% for item in items %}\n    <tr>\n      <td class=\"no\">{{ loop.index }}</td>\n      <td>{{ item.product_description or \"\" }}</td>\n      <td class=\"q\">{{ item.quantity if item.quantity is not none else \"\" }}</td>\n      <td class=\"p\">{{ money(item.unit_price) }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<div class=\"notice\"><div class=\"nt\">IMPORTANT</div>\n<div>YOU HAVE THE RIGHT TO REFUSE CONSENT</div><div>IF YOU DO, THE CREDIT PROVIDER MAY GO TO</div><div>COURT FOR PERMISSION TO ENTER THE PREMISES</div></div>\n{% set customer_date = doc.form2_customer_date or doc.custom_flexi_form2_date %}\n<table class=\"sign\"><tr><td style=\"width:55%;\"><div class=\"who\">Customer</div><div class=\"box\">{% if doc.custom_applicant_signature %}<img class=\"sig-img\" src=\"{{ doc.custom_applicant_signature }}\"/>{% endif %}</div><div class=\"cap\">Signature</div>\n<div class=\"line\"><span>Name:</span>&nbsp; <b>{{ doc.applicant_name or '' }}</b></div><div class=\"line\"><span>Date:</span>&nbsp; <b>{{ frappe.utils.formatdate(customer_date or frappe.utils.nowdate(), \"dd-mm-yyyy\") }}</b></div></td><td></td></tr></table>\n{% if has_co_applicants %}\n{% for co_applicant in co_applicants %}\n<table class=\"sign\"><tr><td style=\"width:55%;\"><div class=\"who\">Co-applicant</div><div class=\"box\"></div><div class=\"cap\">Signature</div>\n<div class=\"line\"><span>Name:</span>&nbsp; <b>{{ applicant_name(co_applicant) }}</b></div><div class=\"line\"><span>Date:</span>&nbsp; <b>{{ frappe.utils.formatdate(customer_date, \"dd-mm-yyyy\") if customer_date else \"\" }}</b></div></td><td></td></tr></table>\n{% endfor %}\n{% endif %}\n\n",
