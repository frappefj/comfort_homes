; background: #fafafa; }\n    .sig-label { font-size: 6.5pt; text-transform: uppercase; color: #64748b; font-weight: 600; margin-bottom: 2px; }\n    .sig-img { max-height: 40px; max-width: 100%; }\n</style>\n</head>\n<body>\n\n{#- ==================== UTILITY MACROS ==================== -#}\n{#- v() reads from web form (custom_flexi_*) first, then desk form (custom_*) -#}\n{% macro v(f, d) -%}\n    {{ doc.get(f) or doc.get(d) or '' }}\n{%- endmacro %}\n\n{% macro vn(f, d) -%}\n    {{ doc.get(f) or doc.get(d) or 0 }}\n{%- endmacro %}\n\n{% macro money(val) -%}\n    {%- if val -%}{{ frappe.format_value(val|float, {'fieldtype': 'Currency'}) }}{%- else -%}\u2014{%- endif -%}\n{%- endmacro %}\n\n{#- mv() = money from dual-source -#}\n{% macro mv(f, d) -%}\n    {%- set val = doc.get(f) or doc.get(d) -%}\n    {%- if val -%}{{ frappe.format_value(val|float, {'fieldtype': 'Currency'}) }}{%- else -%}\u2014{%- endif -%}\n{%- endmacro %}\n\n{% macro row2(label1, val1, label2, val2, is_currency=false) %}\n<div class=\"info-row\">\n    <div class=\"info-cell\"><div class=\"data-container\">\n        <span class=\"label-text\">{{ label1 }}</span>\n        <span class=\"value-text {% if is_currency %}currency-highlight{% endif %}\">{{ val1 or '\u2014' }}</span>\n    </div></div>\n    <div class=\"info-cell\">{% if label2 %}<div class=\"data-container\">\n        <span class=\"label-text\">{{ label2 }}</span>\n        <span class=\"value-text {% if is_currency %}currency-highlight{% endif %}\">{{ val2 or '\u2014' }}</span>\n    </div>{% endif %}</div>\n</div>\n{% endmacro %}\n\n{#- Dual-source field values -#}\n{% set fathers_name     = doc.get('custom_flexi_fathers_name') or doc.get('custom_fathers_name') or '' %}\n{% set dob              = doc.get('custom_flexi_date_of_birth') or doc.get('custom_date_of_birth') %}\n{% set age              = doc.get('custom_flexi_age') or doc.get('custom_age') %}\n{% set marital          = doc.get('custom_flexi_marital_status') or doc.get('custom_marital_status') or '' %}\n{% set dependents       = doc.get('custom_flexi_number_of_dependents') or doc.get('custom_number_of_dependents') %}\n{% set housing          = doc.get('custom_flexi_housing_situation') or doc.get('custom_housing_situation') or '' %}\n{% set postal_addr      = doc.get('custom_flexi_postal_address') or doc.get('custom_postal_address') or '' %}\n{% set employer         = doc.get('custom_flexi_employer_name') or doc.get('custom_employer_name') or '' %}\n{% set occupation       = doc.get('custom_flexi_occupation') or doc.get('custom_occupation') or '' %}\n{% set emp_period       = doc.get('custom_flexi_employment_period') or doc.get('custom_employment_period') or '' %}\n{% set emp_contact      = doc.get('custom_flexi_employer_contact') or doc.get('custom_employer_contact') or '' %}\n{% set emp_address      = doc.get('custom_flexi_employer_address') or doc.get('custom_employer_address') or '' %}\n{% set cash_price       = doc.get('custom_flexi_cash_price') or doc.get('custom_cash_price') %}\n{% set surcharge_rate   = doc.get('custom_surcharge_rate') or doc.get('custom_flexi_surcharge_rate') %}\n{% set surcharge_amt    = doc.get('custom_surcharge_amount') or doc.get('custom_flexi_surcharge_amount') %}\n{% set eff_price        = doc.get('custom_effective_cash_price') or doc.get('custom_flexi_full_value') %}\n{% set deposit_amt      = doc.get('custom_flexi_deposit_amount') or doc.get('custom_deposit_amount') %}\n{% set deposit_pct      = doc.get('custom_flexi_deposit_percent') %}\n{% set bal_after_dep    = doc.get('custom_flexi_value_after_deposit') or doc.get('custom_value_after_deposit') %}\n{% set admin_fee        = doc.get('custom_flexi_admin_fee') or doc.get('custom_admin_fee') %}\n{% set admin_fee_rate   = doc.get('custom_admin_fee_rate') or 2.5 %}\n{% set doc_fee          = doc.get('custom_flexi_documentation_fee') or doc.get('custom_documentation_fee') %}\n{% set stamp_duty       = doc.get('custom_flexi_stamp_duty_fee') or doc.get('custom_stamp_duty_fee') %}\n{% set other_fee        = doc.get('custom_flexi_other_fee') %}\n{% set net_financed     = doc.get('custom_flexi_net_amount_financed') or doc.get('custom_net_amount_financed') %}\n{% set hp_acct_no       = doc.get('custom_flexi_hp_account_number') or doc.get('custom_hp_account_no') or '' %}\n{% set int_rate         = doc.get('custom_flexi_interest_rate') or doc.rate_of_interest %}\n{% set term_months      = doc.get('custom_flexi_term_months') or doc.repayment_periods %}\n{% set term_charges     = doc.get('custom_flexi_term_charges') or doc.total_payable_interest %}\n{% set total_recv       = doc.get('custom_flexi_total_receivable') or doc.total_payable_amount %}\n{% set pay_pref         = doc.get('custom_flexi_payment_period') or doc.get('custom_payment_method') or '' %}\n{% set tot_m_income     = doc.get('custom_flexi_total_monthly_income') or doc.get('custom_total_monthly_income') %}\n{% set tot_a_income     = doc.get('custom_flexi_total_annual_income') or doc.get('custom_total_annual_income') %}\n{% set tot_m_expenses   = doc.get('custom_flexi_total_monthly_expenses') or doc.get('custom_total_monthly_expenses') %}\n{% set net_m_income     = doc.get('custom_flexi_net_monthly_income') or doc.get('custom_net_monthly_income') %}\n{% set tot_obligations  = doc.get('custom_flexi_total_finance_obligations') or doc.get('custom_total_finance_obligations') %}\n{% set sel_dsr          = doc.get('custom_flexi_selected_dsr') or doc.get('custom_selected_dsr') or 35 %}\n{% set post_dsr         = doc.get('custom_flexi_post_dsr') or doc.get('custom_post_dsr') or 0 %}\n{% set pre_dsr          = doc.get('custom_flexi_pre_dsr') or doc.get('custom_pre_dsr') or 0 %}\n{% set dsr_margin       = doc.get('custom_flexi_dsr_margin') or doc.get('custom_dsr_margin') or 0 %}\n{% set dsr_net_income   = doc.get('custom_flexi_dsr_net_income') or doc.get('custom_dsr_net_income') %}\n{% set dsr_total_income = doc.get('custom_flexi_dsr_total_income') or doc.get('custom_dsr_total_income') %}\n{% set quotation_no     = doc.get('custom_flexi_quotation_number') or '' %}\n{% set first_inst_date  = doc.get('custom_flexi_first_instalment_date') or doc.get('custom_first_instalment_date') %}\n{% set last_inst_date   = doc.get('custom_flexi_last_instalment_date') %}\n{% set admin_fee_rate_v  = doc.get('custom_flexi_admin_fee_rate') or doc.get('custom_admin_fee_rate') or 2.5 %}\n{% set elig_status      = doc.get('custom_flexi_eligibility_status') or doc.get('custom_eligibility_status') or 'Not Assessed' %}\n{% set weekly_elig      = doc.get('custom_weekly_eligibility') %}\n{% set income_basis     = doc.get('custom_flexi_income_basis') or doc.get('custom_income_basis') or '' %}\n{% set items            = doc.get('custom_flexi_purchase_items') or doc.get('custom_purchase_items') or [] %}\n{% set incomes          = doc.get('custom_flexi_income_entries') or doc.get('custom_income_entries') or [] %}\n{% set expenses         = doc.get('custom_flexi_living_expenses') or doc.get('custom_living_expenses') or [] %}\n{% set obligations      = doc.get('custom_flexi_finance_obligations') or doc.get('custom_finance_obligations') or [] %}\n{% set contacts         = doc.get('custom_flexi_application_contacts') or doc.get('custom_application_contacts') or [] %}\n{% set co_applicants = get_co_applicants(doc.name) %}\n{% set has_co_applicants = co_applicants|length > 0 %}\n{# Print-only joint assessment: no doc.set, database writes, or saved status changes.\n   DSR and eligibility formulas mirror Calculations.py using the recorded totals.\n   Existing co-applicant helpers supply the linked applicants' monthly figures. #}\n{% set household = namespace(income=((tot_m_income or 0)|float), obligations=((tot_obligations or 0)|float)) %}\n{% set print_applicant = namespace(name=(doc.applicant_name or doc.applicant or '\u2014')) %}\n{% set joint_assessment = namespace(frequency='Monthly', selected_monthly=0, weekly_amount=0, assessed=false) %}\n{% if has_co_applicants %}\n    {% for co_applicant in co_applicants %}\n        {% set household.income = household.income + ((co_applicant_monthly_income(co_applicant) or 0)|float) %}\n        {% set household.obligations = household.obligations + ((co_applicant_financial_obligations(co_applicant) or 0)|float) %}\n        {% set co_display_name = applicant_name(co_applicant) %}\n        {% if co_display_name %}\n            {% set print_applicant.name = print_applicant.name ~ ' & ' ~ co_display_name %}\n        {% endif %}\n    {% endfor %}\n\n    {# Match the server's frequency-selection loop on the primary income entries. #}\n    {% for income_row in incomes %}\n        {% if joint_assessment.frequency == 'Monthly' and income_row.frequency %}\n            {% set joint_assessment.frequency = income_row.frequency %}\n        {% endif %}\n    {% endfor %}\n    {% set joint_weeks_per_month = (52 / 12) if joint_assessment.frequency in ('Weekly', 'Fortnightly') else 4 %}\n    {% set joint_max_dsr = (sel_dsr or 35)|float %}\n    {% set joint_pre_dsr = (household.obligations / household.income * 100) if household.income else 0 %}\n    {% set joint_weekly_capacity_raw = (household.income * joint_max_dsr / 100 - household.obligations) / joint_weeks_per_month %}\n    {% set joint_weekly_capacity = joint_weekly_capacity_raw if joint_weekly_capacity_raw > 0 else 0 %}\n\n    {# Reconstruct unrounded instalments from recorded receivable and term.\n       Do not monthly-normalise an already-rounded instalment field. #}\n    {% set joint_months = ((doc.get('custom_flexi_term_months') or 12)|float)|int %}\n    {% set joint_receivable = (total_recv or 0)|float %}\n    {% set joint_counts = {\n        'Weekly': (joint_months * 52 / 12)|round|int,\n        'Fortnightly': (joint_months * 26 / 12)|round|int,\n        'Bi-monthly': joint_months * 2,\n        'Monthly': joint_months\n    } %}\n    {% set joint_weekly_count = joint_counts.get('Weekly') %}\n    {% set joint_assessment.weekly_amount = (joint_receivable / joint_weekly_count) if joint_weekly_count else 0 %}\n    {% set joint_monthly_amount = (joint_receivable / joint_months) if joint_months else 0 %}\n    {% set joint_period = doc.get('custom_flexi_payment_period') %}\n    {% set joint_selected_count = joint_counts.get(joint_period, joint_months) %}\n    {% set joint_selected_instalment = (joint_receivable / joint_selected_count) if joint_selected_count else 0 %}\n    {% set joint_monthly_factors = {'Weekly': 52 / 12, 'Fortnightly': 26 / 12, 'Bi-monthly': 2, 'Monthly': 1} %}\n    {% set joint_assessment.selected_monthly = joint_selected_instalment * joint_monthly_factors.get(joint_period, 1) %}\n    {% set joint_post_dsr = ((household.obligations + joint_assessment.selected_monthly) / household.income * 100) if household.income else 0 %}\n    {% set joint_assessment.assessed = household.income > 0 and joint_receivable > 0 %}\n    {% set joint_eligible = joint_assessment.assessed and joint_assessment.weekly_amount <= joint_weekly_capacity and joint_post_dsr <= joint_max_dsr %}\n\n    {# Override LOCAL DISPLAY VARIABLES ONLY; single-applicant path is unchanged. #}\n    {% set tot_m_income = household.income|round(2) %}\n    {% set tot_a_income = (household.income * 12)|round(2) %}\n    {% set tot_obligations = household.obligations|round(2) %}\n    {% set dsr_total_income = household.income|round(2) %}\n    {% set dsr_net_income = (household.income - household.obligations)|round(2) %}\n    {% set pre_dsr = joint_pre_dsr|round(2) %}\n    {% set post_dsr = joint_post_dsr|round(2) %}\n    {% set joint_margin_raw = joint_max_dsr - joint_pre_dsr %}\n    {% set dsr_margin = (joint_margin_raw if joint_margin_raw > 0 else 0)|round(2) %}\n    {% set weekly_elig = joint_weekly_capacity|round(2) %}\n    {% set elig_status = 'Achieved' if joint_eligible else ('Not Achieved' if joint_assessment.assessed else 'Not Assessed') %}\n{% endif %}\n{% set spouse_first     = doc.get('custom_flexi_spouse_first_name') or doc.get('custom_spouse_first_name') or '' %}\n\n<!-- ========== HEADER ========== -->\n<table class=\"header-table\">\n    <tr>\n        <td class=\"header-title\">\n            <h1>Loan Application Summary</h1>\n            <div style=\"font-size:8pt; margin-top:2px; color:#64748b;\">Comfort Home Furnishing \u2014 HP Assessment Sheet</div>\n        </td>\n        <td class=\"header-meta\">\n            <strong>Application:</strong> {{ doc.name }}<br>\n            <strong>Date:</strong> {{ frappe.format(doc.posting_date, {\"fieldtype\":\"Date\"}) or 'N/A' }}<br>\n            {% if doc.get('custom_card_id') %}<strong>Card ID:</strong> {{ doc.custom_card_id }}<br>{% endif %}\n            {% if doc.get('custom_branchlocation') %}<strong>Branch:</strong> {{ doc.custom_branchlocation }}<br>{% endif %}\n            <span class=\"badge-status\">{{ doc.status or 'Open' }}</span>\n        </td>\n    </tr>\n</table>\n\n<!-- ========== EXECUTIVE DASHBOARD ========== -->\n<table class=\"dashboard-panel\">\n    <tr>\n        <td class=\"kpi-card\">\n            <div class=\"kpi-label\">Loan Amount</div>\n            <div class=\"kpi-value\">{{ money(doc.loan_amount) }}</div>\n        </td>\n        <td class=\"kpi-card {% if post_dsr|float > sel_dsr|float %}alert-dsr{% endif %}\">\n            <div class=\"kpi-label\">{% if has_co_applicants %}Joint {% endif %}Post-Application DSR</div>\n            <div class=\"kpi-value\">{{ (post_dsr|float)|round(1) }}%</div>\n        </td>\n        <td class=\"kpi-card\">\n            <div class=\"kpi-label\">Max Allowed DSR</div>\n            <div class=\"kpi-value\">{{ sel_dsr }}%</div>\n        </td>\n        <td class=\"kpi-card\">\n            <div class=\"kpi-label\">{% if has_co_applicants %}Joint Print {% endif %}Eligibility</div>\n            <div class=\"kpi-value\" style=\"font-size:9pt\">{{ elig_status }}</div>\n        </td>\n    </tr>\n</table>\n\n<!-- ========== APPLICANT PROFILE ========== -->\n<div class=\"section-heading\">Applicant Profile</div>\n<div class=\"info-grid\">\n    {{ row2('Full Name', print_applicant.name,\n            'Card ID', doc.get('custom_card_id') or '\u2014') }}\n    {{ row2('Applicant Type', doc.applicant_type or '\u2014',\n            'Applicant (Link)', doc.applicant or '\u2014') }}\n    {{ row2('Date of Birth', frappe.format(dob, {\"fieldtype\":\"Date\"}) if dob else '\u2014',\n            'Age', age or '\u2014') }}\n    {{ row2('TIN Number', doc.get('custom_tin_number') or '\u2014',\n            'FNPF Number', doc.get('custom_fnpf_number') or '\u2014') }}\n    {{ row2(\"Father's Name\", fathers_name or '\u2014',\n            'Marital Status', marital or '\u2014') }}\n    {{ row2('No. of Dependents', dependents or '\u2014',\n            'Housing Situation', housing or '\u2014') }}\n    {{ row2('Phone', doc.applicant_phone_number or '\u2014',\n            'Email', doc.applicant_email_address or '\u2014') }}\n    {{ row2('Customer Bank', doc.get('custom_customer_bank') or '\u2014',\n            'Bank Account No', doc.get('custom_customer_bank_account_no') or '\u2014') }}\n</div>\n\n<!-- ========== ADDRESS ========== -->\n<div class=\"section-heading\">Address &amp; Employment</div>\n<div class=\"info-grid\">\n    {{ row2('Address Line 1', doc.get('address_line_1') or '\u2014',\n            'Suburb', doc.get('custom_suburb') or '\u2014') }}\n    {{ row2('City', doc.get('custom_new_city') or doc.get('city') or '\u2014',\n            'Province', doc.get('custom_province') or doc.get('state') or '\u2014') }}\n    {{ row2('Country', doc.get('country') or '\u2014',\n            'Postal Address', postal_addr or '\u2014') }}\n    {{ row2('Employer', employer or '\u2014',\n            'Occupation', occupation or '\u2014') }}\n    {{ row2('Employment Period', emp_period or '\u2014',\n            'Employer Contact', emp_contact or '\u2014') }}\n</div>\n\n<!-- ========== PROPOSED HIRE PURCHASE ITEMS ========== -->\n<div class=\"section-heading\">Proposed Hire Purchase Items</div>\n{% if items %}\n<table class=\"child-table\">\n    <thead><tr>\n        <th style=\"width:5%\">#</th>\n        <th>Product Description</th>\n        <th style=\"width:8%; text-align:right\">Qty</th>\n        <th style=\"width:15%; text-align:right\">Unit Price</th>\n        <th style=\"width:15%; text-align:right\">Total</th>\n    </tr></thead>\n    <tbody>\n    {% for item in items %}\n    <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ item.product_description or item.item_name or item.description or '\u2014' }}</td>\n        <td class=\"amt\">{{ item.quantity or 1 }}</td>\n        <td class=\"amt\">{{ money(item.unit_price) }}</td>\n        <td class=\"amt\">{{ money(item.total_amount) }}</td>\n    </tr>\n    {% endfor %}\n    <tr class=\"total-row\">\n        <td colspan=\"4\" style=\"text-align:right\">Total Purchase Value</td>\n        <td class=\"amt\">{{ money(cash_price) }}</td>\n    </tr>\n    </tbody>\n</table>\n{% else %}\n<p style=\"color:#94a3b8; font-style:italic; margin:4px 0;\">No purchase items recorded.</p>\n{% endif %}\n\n<!-- ========== HP FINANCIAL STRUCTURE ========== -->\n<div class=\"section-heading\">HP Financial Structure</div>\n<div class=\"info-grid\">\n    {{ row2('Cash Price of Goods', money(cash_price),\n            'Loan Product', doc.loan_product or '\u2014') }}\n    {% if surcharge_rate %}\n    {{ row2('Surcharge Rate', (surcharge_rate or 0) ~ '%',\n            'Surcharge Amount', money(surcharge_amt)) }}\n    {{ row2('Effective Cash Price', money(eff_price), '', '') }}\n    {% endif %}\n    {{ row2('Deposit Amount', money(deposit_amt) ~ (' (' ~ deposit_pct ~ '%)' if deposit_pct else ''),\n            'Balance After Deposit', money(bal_after_dep), true) }}\n    {{ row2('Admin Fee (' ~ admin_fee_rate_v ~ '%)', money(admin_fee),\n            'Documentation Fee', money(doc_fee), true) }}\n    {% if stamp_duty or other_fee %}\n    {{ row2('Stamp Duty Fee', money(stamp_duty),\n            'Other Fee', money(other_fee) if other_fee else '\u2014') }}\n    {% endif %}\n    {{ row2('Net Amount Financed', money(net_financed),\n            'HP Account No', hp_acct_no or '\u2014', true) }}\n</div>\n\n<!-- ========== LOAN PRICING & TERMS ========== -->\n<div class=\"section-heading\">Loan Pricing &amp; Terms</div>\n<div class=\"info-grid\">\n    {{ row2('Loan Amount', money(doc.loan_amount),\n            'Interest Rate', (int_rate or 0) ~ '%') }}\n    {{ row2('Term (Months)', term_months or '\u2014',\n            'Repayment Method', doc.repayment_method or '\u2014') }}\n    {{ row2('Total Interest / Charges', money(term_charges),\n            'Total Payable', money(total_recv), true) }}\n    {{ row2('Monthly Repayment', money(doc.repayment_amount),\n            'Payment Preference', pay_pref or '\u2014', true) }}\n    {#- Show instalment breakdown if available from web form -#}\n    {% if doc.get('custom_flexi_weekly_instalment_amount') %}\n    {{ row2('Weekly Instalment', money(doc.custom_flexi_weekly_instalment_amount),\n            'Fortnightly Instalment', money(doc.get('custom_flexi_fortnightly_instalment_amount')), true) }}\n    {{ row2('Bi-Monthly Instalment', money(doc.get('custom_flexi_bimonthly_instalment_amount')),\n            'Monthly Instalment', money(doc.get('custom_flexi_monthly_instalment_amount')), true) }}\n    {% endif %}\n    {% if first_inst_date or quotation_no %}\n    {{ row2('First Instalment Date', frappe.format(first_inst_date, {\"fieldtype\":\"Date\"}) if first_inst_date else '\u2014',\n            'Quotation / Ref No', quotation_no or '\u2014') }}\n    {% endif %}\n    {% if last_inst_date %}\n    {{ row2('Last Instalment Date', frappe.format(last_inst_date, {\"fieldtype\":\"Date\"}), '', '') }}\n    {% endif %}\n</div>\n\n<!-- ========== DSR / CREDIT ASSESSMENT ========== -->\n<div class=\"section-heading\">{% if has_co_applicants %}Joint {% endif %}Credit Underwriting &amp; DSR Analysis</div>\n<div class=\"info-grid\">\n    {{ row2('Total Monthly Income', money(tot_m_income),\n            'Total Annual Income', money(tot_a_income), true) }}\n    {{ row2('Primary Applicant Monthly Expenses' if has_co_applicants else 'Total Monthly Expenses', money(tot_m_expenses),\n            'Primary Applicant Net Monthly Income' if has_co_applicants else 'Net Monthly Income', money(net_m_income), true) }}\n    {{ row2('Total Finance Obligations', money(tot_obligations),\n            'DSR Net Income', money(dsr_net_income), true) }}\n    {{ row2('Pre-DSR', (pre_dsr or 0) ~ '%',\n            'Post-DSR', (post_dsr or 0) ~ '%') }}\n    {{ row2('Selected Max DSR', (sel_dsr or 35) ~ '%',\n            'DSR Margin', (dsr_margin or 0) ~ '%') }}\n    {{ row2('Eligibility Status', elig_status,\n            'Weekly Eligibility', money(weekly_elig)) }}\n    {% if income_basis %}\n    <div class=\"info-row\"><div class=\"info-cell\" style=\"width:100%\"><div class=\"data-container\">\n        <span class=\"label-text\">Income Basis / Notes</span>\n        <span class=\"value-text\">{{ income_basis }}</span>\n    </div></div></div>\n    {% endif %}\n</div>\n\n<!-- ========== CO-APPLICANT HOUSEHOLD ASSESSMENT ========== -->\n{% if has_co_applicants %}\n<div class=\"section-heading\">Applicant &amp; Co-Applicant Assessment Summary</div>\n<table class=\"child-table\">\n  <thead><tr><th>Applicant</th><th style=\"width:28%; text-align:right\">Monthly Income</th><th style=\"width:30%; text-align:right\">Existing Financial Obligations</th></tr></thead>\n  <tbody>\n    <tr><td>{{ doc.applicant_name or doc.applicant or 'Primary Applicant' }}</td><td class=\"amt\">{{ money(doc.get('custom_flexi_total_monthly_income') or doc.get('custom_total_monthly_income')) }}</td><td class=\"amt\">{{ money(doc.get('custom_flexi_total_finance_obligations') or doc.get('custom_total_finance_obligations')) }}</td></tr>\n    {% for co_applicant in co_applicants %}\n      {% set co_income = co_applicant_monthly_income(co_applicant) %}\n      {% set co_obligations = co_applicant_financial_obligations(co_applicant) %}\n      <tr><td>{{ applicant_name(co_applicant) }}</td><td class=\"amt\">{{ money(co_income) }}</td><td class=\"amt\">{{ money(co_obligations) }}</td></tr>\n    {% endfor %}\n    <tr class=\"total-row\"><td>Combined household total</td><td class=\"amt\">{{ money(household.income) }}</td><td class=\"amt\">{{ money(household.obligations) }}</td></tr>\n  </tbody>\n</table>\n<div style=\"font-size:7.5pt; color:#64748b; margin:4px 0 8px;\">This print-only joint assessment combines the linked applicants\u2019 recorded monthly income and existing financial obligations. Pre-DSR, post-DSR, DSR margin, weekly eligibility and the displayed eligibility result are recalculated for this print only; saved application values and approval decisions are not changed. The proposed repayment is included once, as a monthly equivalent of the selected payment period. DSR uses income before living expenses. Expenses and net monthly income labelled Primary Applicant remain individual figures. Weekly eligibility follows the primary application's income-frequency rule. {% if not joint_assessment.assessed %}<strong>Not assessed: combined income and a positive recorded total receivable are required; displayed zero DSR is not an affordability clearance.</strong>{% endif %}</div>\n{% endif %}\n\n<!-- ========== INCOME TABLE ========== -->\n{# With a co-applicant, the household summary above is authoritative for this\n   assessment print.  Do not repeat only the primary applicant's rows below. #}\n{% if incomes and not has_co_applicants %}\n<div class=\"section-heading\">Income Details</div>\n<table class=\"child-table\">\n    <thead><tr><th>Source / Type</th><th style=\"width:15%\">Frequency</th><th style=\"width:15%; text-align:right\">Amount</th><th style=\"width:15%; text-align:right\">Monthly</th></tr></thead>\n    <tbody>\n    {% for row in incomes %}\n    <tr>\n        <td>{{ row.income_type or row.source or '\u2014' }}</td>\n        <td>{{ row.frequency or '\u2014' }}</td>\n        <td class=\"amt\">{{ money(row.amount) }}</td>\n        <td class=\"amt\">{{ money(row.monthly_amount) }}</td>\n    </tr>\n    {% endfor %}\n    <tr class=\"total-row\"><td colspan=\"3\" style=\"text-align:right\">Total Monthly Income</td><td class=\"amt\">{{ money(tot_m_income) }}</td></tr>\n    </tbody>\n</table>\n{% endif %}\n\n<!-- ========== FINANCE OBLIGATIONS TABLE ========== -->\n{% if obligations and not has_co_applicants %}\n<div class=\"section-heading\">Existing Finance Obligations</div>\n<table class=\"child-table\">\n    <thead><tr><th>Institution / Description</th><th style=\"width:15%\">Frequency</th><th style=\"width:15%; text-align:right\">Amount</th><th style=\"width:15%; text-align:right\">Monthly</th></tr></thead>\n    <tbody>\n    {% for row in obligations %}\n    <tr>\n        <td>{{ row.institution or row.creditor or row.description or '\u2014' }}</td>\n        <td>{{ row.frequency or '\u2014' }}</td>\n        <td class=\"amt\">{{ money(row.amount) }}</td>\n        <td class=\"amt\">{{ money(row.monthly_amount) }}</td>\n    </tr>\n    {% endfor %}\n    <tr class=\"total-row\"><td colspan=\"3\" style=\"text-align:right\">Total Monthly Obligations</td><td class=\"amt\">{{ money(tot_obligations) }}</td></tr>\n    </tbody>\n</table>\n{% endif %}\n\n<!-- ========== SPOUSE (if populated) ========== -->\n{% if spouse_first %}\n<div class=\"section-heading\">Spouse Details</div>\n<div class=\"info-grid\">\n    {% set sp_mid = doc.get('custom_flexi_spouse_middle_name') or doc.get('custom_spouse_middle_name') or '' %}\n    {% set sp_sur = doc.get('custom_flexi_spouse_surname') or doc.get('custom_spouse_surname') or '' %}\n    {% set sp_dob = doc.get('custom_flexi_spouse_dob') or doc.get('custom_spouse_dob') %}\n    {% set sp_mob = doc.get('custom_flexi_spouse_mobile') or doc.get('custom_spouse_mobile') or '' %}\n    {% set sp_emp = doc.get('custom_flexi_spouse_employer') or doc.get('custom_spouse_employer') or '' %}\n    {% set sp_occ = doc.get('custom_flexi_spouse_occupation') or doc.get('custom_spouse_occupation') or '' %}\n    {{ row2('Spouse Name', spouse_first ~ ' ' ~ sp_mid ~ ' ' ~ sp_sur,\n            'Spouse DOB', frappe.format(sp_dob, {\"fieldtype\":\"Date\"}) if sp_dob else '\u2014') }}\n    {{ row2('Spouse Mobile', sp_mob or '\u2014',\n            'Spouse Employer', sp_emp or '\u2014') }}\n    {{ row2('Spouse Occupation', sp_occ or '\u2014', '', '') }}\n</div>\n{% endif %}\n\n<!-- ========== CONTACTS TABLE ========== -->\n{% if contacts %}\n<div class=\"section-heading\">Family Relatives &amp; Office Referees</div>\n<table class=\"child-table\">\n    <thead><tr><th style=\"width:18%\">Type</th><th>Full Name</th><th style=\"width:18%\">Relationship</th><th style=\"width:20%\">Mobile Number</th></tr></thead>\n    <tbody>\n    {% for c in contacts %}\n    <tr>\n        <td>{{ c.contact_type or '\u2014' }}</td>\n        <td>{{ c.full_name or c.contact_name or '\u2014' }}</td>\n        <td>{{ c.relationship or '\u2014' }}</td>\n        <td>{{ c.mobile_number or c.phone or '\u2014' }}</td>\n    </tr>\n    {% endfor %}\n    </tbody>\n</table>\n{% endif %}\n\n<!-- ========== SIGNATURES ========== -->\n<div class=\"section-heading\">Signatures &amp; Verification</div>\n<div class=\"sig-grid\">\n    <div class=\"sig-cell\">\n        <div class=\"sig-box\">\n            <div class=\"sig-label\">Applicant Signature</div>\n            {% if doc.get('custom_applicant_signature') %}<img class=\"sig-img\" src=\"{{ doc.custom_applicant_signature }}\">\n            {% else %}<div style=\"height:35px;\"></div>{% endif %}\n        </div>\n    </div>\n    <div class=\"sig-cell\">\n        <div class=\"sig-box\">\n            <div class=\"sig-label\">Witness: {{ doc.get('custom_witness_name') or '________________' }}</div>\n            {% if doc.get('custom_witness_signature') %}<img class=\"sig-img\" src=\"{{ doc.custom_witness_signature }}\">\n            {% elif doc.get('custom_cira_authority_signature') %}<img class=\"sig-img\" src=\"{{ doc.custom_cira_authority_signature }}\">\n            {% else %}<div style=\"height:35px;\"></div>{% endif %}\n            {% if doc.get('custom_witness_address') %}<div style=\"font-size:7pt; color:#64748b;\">{{ doc.custom_witness_address }}</div>{% endif %}\n            {% if doc.get('custom_witness_date') %}<div style=\"font-size:7pt; color:#64748b;\">Date: {{ frappe.format(doc.custom_witness_date, {\"fieldtype\":\"Date\"}) }}</div>{% endif %}\n        </div>\n    </div>\n    <div class=\"sig-cell\">\n        <div class=\"sig-box\">\n            <div class=\"sig-label\">Company Rep: {{ doc.get('custom_company_rep_name') or '________________' }}</div>\n            {% if doc.get('custom_company_rep_signature') %}<img class=\"sig-img\" src=\"{{ doc.custom_company_rep_signature }}\">\n            {% else %}<div style=\"height:35px;\"></div>{% endif %}\n            {% if doc.get('custom_company_rep_date') %}<div style=\"font-size:7pt; color:#64748b;\">Date: {{ frappe.format(doc.custom_company_rep_date, {\"fieldtype\":\"Date\"}) }}</div>{% endif %}\n        </div>\n    </div>\n</div>\n\n{% set cira_name = doc.get('custom_cira_authority_name') or doc.get('custom_cira_name') or '' %}\n{% set cira_ack = doc.get('custom_cira_authority_acknowledged') or doc.get('custom_cira_acknowledged') %}\n{% if cira_name or cira_ack %}\n<div style=\"margin-top:4px; font-size:7.5pt; color:#475569;\">\n    <strong>CIRA Authority:</strong> {{ cira_name or '\u2014' }}\n    {% if cira_ack %} \u2014 <span style=\"color:#03543f; font-weight:600;\">\u2713 Acknowledged</span>{% endif %}\n</div>\n{% endif %}\n\n<!-- ========== ATTACHMENT SUMMARY ========== -->\n<div class=\"section-heading\">Attachment Summary</div>\n{%- set attachments = frappe.get_all('File',\n    filters={'attached_to_doctype': 'Loan Application', 'attached_to_name': doc.name, 'is_private': ['in', [0,1]]},\n    fields=['file_name', 'file_size', 'creation', 'is_private'],\n    order_by='creation') -%}\n{% if attachments %}\n<table class=\"child-table\">\n    <thead><tr><th style=\"width:5%\">#</th><th>File Name</th><th style=\"width:15%; text-align:right\">Size</th><th style=\"width:20%\">Uploaded</th></tr></thead>\n    <tbody>\n    {% for att in attachments %}\n    <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ att.file_name }}</td>\n        <td class=\"amt\">{{ (att.file_size / 1024)|round(1) ~ ' KB' if att.file_size else '\u2014' }}</td>\n        <td>{{ frappe.format(att.creation, {\"fieldtype\":\"Datetime\"}) }}</td>\n    </tr>\n    {% endfor %}\n    </tbody>\n</table>\n{% else %}\n<p style=\"color:#94a3b8; font-style:italic; margin:4px 0;\">No attachments found.</p>\n{% endif %}\n\n<!-- ========== COMPLIANCE FOOTER ========== -->\n<div class=\"footer-declaration\">\n    <p>\n        <strong>Compliance Declaration:</strong> This document is an automated data extract from Loan Application\n        <strong>{{ doc.name }}</strong> for <strong>{{ print_applicant.name }}</strong>.\n        Generated on <strong>{{ frappe.format(frappe.utils.today(), {\"fieldtype\":\"Date\"}) }}</strong> for underwriting review.\n        {% if has_co_applicants %}Joint assessment figures are calculated for this print from recorded applicant data; no combined figures are saved to the database. The printed joint eligibility result is not a saved approval decision.{% else %}All financial calculations are system-generated.{% endif %} Verify source documents before final approval.\n    </p>\n</div>\n\n<!-- ========== ASSESSOR SIGN-OFF ========== -->\n<div class=\"signoff-section\">\n    <div class=\"section-heading\">Assessor Decision &amp; Sign-Off</div>\n    <table class=\"signoff-table\">\n        <tr><th>Credit Decision</th><td>[ &nbsp; ] Approved &nbsp; &nbsp; [ &nbsp; ] Declined &nbsp; &nbsp; [ &nbsp; ] Defer / Escalate</td></tr>\n        <tr><th>Conditions / Notes</th><td class=\"comment-box\"></td></tr>\n        <tr><th>Approved Amount</th><td></td></tr>\n        <tr><th>Assessor Signature &amp; Date</th><td></td></tr>\n    </table>\n</div>\n\n</body>\n</html>\n\n",
