-  "script": "flt = frappe.utils.flt\n\ndef normalize_fiji_phone(value):\n    value = str(value or \"\").strip()\n    digits = \"\".join(character for character in value if character.isdigit())\n    while digits.startswith(\"679679\"):\n        digits = digits[3:]\n    if digits.startswith(\"679\"):\n        digits = digits[3:]\n    return \"+679-\" + digits if len(digits) == 7 else value\n\nif doc.docstatus == 1 and not doc.is_new():\n    months = int(flt(doc.custom_flexi_term_months or 12))\n    total_receivable = round(flt(doc.custom_flexi_total_receivable), 2)\n    term_charges = round(flt(doc.custom_flexi_term_charges), 2)\n    doc.repayment_periods = months\n    doc.repayment_amount = round(total_receivable / months, 2) if months else 0\n    doc.total_payable_amount = total_receivable\n    doc.total_payable_interest = term_charges\nelse:\n    if doc.applicant_type == \"Customer\" and doc.applicant and frappe.db.exists(\"Customer\", doc.applicant):\n        customer = frappe.get_doc(\"Customer\", doc.applicant)\n        if not customer.customer_name:\n            frappe.throw(\"Customer Full Name is missing in the selected Customer master.\")\n        doc.custom_customer_full_name = customer.customer_name\n        contact = frappe.get_doc(\"Contact\", customer.customer_primary_contact) if customer.customer_primary_contact and frappe.db.exists(\"Contact\", customer.customer_primary_contact) else None\n        address = frappe.get_doc(\"Address\", customer.customer_primary_address) if customer.customer_primary_address and frappe.db.exists(\"Address\", customer.customer_primary_address) else None\n        contact_has_split_name = bool(contact and (contact.middle_name or contact.last_name))\n        full_name = contact.full_name if contact and contact.full_name else (customer.customer_name or \"\")\n        parts = [part for part in full_name.split(\" \") if part]\n        first_name = contact.first_name if contact_has_split_name and contact.first_name else (parts[0] if parts else \"\")\n        middle_name = contact.middle_name if contact_has_split_name and contact.middle_name else (\" \".join(parts[1:-1]) if len(parts) > 2 else \"\")\n        surname = contact.last_name if contact_has_split_name and contact.last_name else (parts[-1] if len(parts) > 1 else \"\")\n        if not doc.custom_first_name:\n            doc.custom_first_name = first_name\n        if not doc.custom_middle_name:\n            doc.custom_middle_name = middle_name\n        if not doc.custom_surname:\n            doc.custom_surname = surname\n        if not doc.custom_tin_number:\n            doc.custom_tin_number = customer.custom_tin_number\n        if not doc.applicant_email_address:\n            doc.applicant_email_address = customer.email_id\n        if not doc.applicant_phone_number:\n            doc.applicant_phone_number = customer.mobile_no\n        if address:\n            if not doc.address_line_1:\n                doc.address_line_1 = address.address_line1\n            if not doc.address_line_2:\n                doc.address_line_2 = address.address_line2\n            if not doc.custom_new_city:\n                doc.custom_new_city = address.city\n            if not doc.city:\n                doc.city = address.city\n            if not doc.custom_province:\n                doc.custom_province = address.state\n            if not doc.state:\n                doc.state = address.state\n            if not doc.country:\n                doc.country = address.country or \"Fiji\"\n            if not doc.zip_code:\n                doc.zip_code = address.pincode\n\n    name_parts = [doc.get(\"custom_first_name\"), doc.get(\"custom_middle_name\"), doc.get(\"custom_surname\")]\n    if any(name_parts):\n        doc.applicant_name = \" \".join(str(part).strip() for part in name_parts if part)\n    for fieldname in (\"applicant_phone_number\", \"custom_flexi_employer_contact\", \"custom_flexi_spouse_mobile\", \"custom_flexi_spouse_employer_contact\"):\n        if doc.get(fieldname):\n            doc.set(fieldname, normalize_fiji_phone(doc.get(fieldname)))\n    for contact in (doc.get(\"custom_flexi_application_contacts\") or []):\n        for fieldname in (\"mobile_number\", \"home_phone\", \"employer_contact\"):\n            if contact.get(fieldname):\n                contact.set(fieldname, normalize_fiji_phone(contact.get(fieldname)))\n\n    flt = frappe.utils.flt\n\n    def money(value):\n        return round(frappe.utils.flt(value), 2)\n\n    monthly_factors = {\n        \"Weekly\": 52 / 12,\n        \"Fortnightly\": 26 / 12,\n        \"Bi-monthly\": 2,\n        \"Monthly\": 1,\n    }\n\n    # Income, expenses, and existing obligations\n    monthly_income = 0\n    annual_salary_after_fnpf = 0\n    annual_factors = {\"Weekly\": 52, \"Fortnightly\": 26, \"Bi-monthly\": 24, \"Monthly\": 12}\n    assessment_frequency = \"Monthly\"\n    for row in (doc.get(\"custom_flexi_income_entries\") or []):\n        exact_monthly = flt(row.amount) * monthly_factors.get(row.frequency, 1)\n        row.monthly_amount = money(exact_monthly)\n        monthly_income += abs(exact_monthly) if row.income_type == \"Salary Deductions\" else exact_monthly\n        if row.income_type == \"Net Salary / Wages\":\n            annual_salary_after_fnpf += flt(row.amount) * annual_factors.get(row.frequency, 12)\n        if assessment_frequency == \"Monthly\" and row.frequency:\n            assessment_frequency = row.frequency\n\n    monthly_expenses = 0\n    for row in (doc.get(\"custom_flexi_living_expenses\") or []):\n        exact_monthly = flt(row.expense_amount) * flt(row.frequency_per_month or 1)\n        row.monthly_amount = money(exact_monthly)\n        monthly_expenses += exact_monthly\n\n    monthly_obligations = 0\n    for row in (doc.get(\"custom_flexi_finance_obligations\") or []):\n        exact_monthly = flt(row.amount) * monthly_factors.get(row.frequency, 1)\n        row.monthly_amount = money(exact_monthly)\n        monthly_obligatio