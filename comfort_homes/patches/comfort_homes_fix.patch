-  "html": "<style>\n/* Flexible Purchase | consistent compact legal print styling.\n   Cosmetic only: no content generated, hidden, truncated, or reordered.\n   Fonts must be installed on the Frappe PDF server. */\n@page { size: A4; margin: 12mm; }\n* { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; }\nbody, .print-format, .hp-contract-body, .info-statement-body, .cira-authority-form {\n  font-family: \"Times New Roman\", \"Liberation Serif\", \"Nimbus Roman\", \"DejaVu Serif\", Times, serif !important;\n  font-size: 10pt !important; line-height: 1.2 !important; color: #000 !important;\n}\n.print-format { padding: 0 !important; }\ntable, td, th, p, div, span, li, small, strong, b, h1, h2, h3, h4 {\n  font-family: inherit;\n}\ntable { width: 100%; border-collapse: collapse; font-size: 10pt; line-height: 1.25; }\ntd, th { vertical-align: top; word-wrap: break-word; }\ntr { page-break-inside: avoid; break-inside: avoid; }\np { margin: 0 0 2.5pt; orphans: 3; widows: 3; }\nul, ol { margin: 3pt 0 5pt; padding-left: 16pt; }\nli { margin-bottom: 2pt; }\nb, strong, .b, .bold { font-weight: bold; }\nsmall, .muted { color: #222; }\nsmall { font-size: 9pt; }\n.center { text-align: center; }\n.right { text-align: right; }\nh1, h2, h3, h4, .sec, .section-category, .qa-question, .h {\n  page-break-after: avoid; break-after: avoid; orphans: 3; widows: 3;\n}\n/* Consistent title hierarchy across existing markup families. */\n.head, .hp-header, .info-header { text-align: center; margin: 0 0 7pt; padding: 0; border: 0; }\n.org, .hp-header h2, .info-header h2 {\n  font-size: 10.5pt; font-weight: bold; line-height: 1.2;\n  letter-spacing: .02em; text-transform: uppercase; margin: 0;\n}\n.org2, .hp-header h3, .info-header h3 {\n  font-size: 9.5pt; font-weight: normal; font-style: italic;\n  line-height: 1.2; letter-spacing: 0; color: #000; margin: 1pt 0 5pt;\n}\n.title, .hp-header h4, .info-header h4, .cira-authority-form h3 {\n  font-size: 13pt; font-weight: bold; line-height: 1.15;\n  letter-spacing: .02em; text-transform: uppercase; margin: 4pt 0 3pt;\n}\n.cira-authority-form h3 { text-align: center; margin-bottom: 7pt; }\n.subtitle, .info-header p { font-size: 9.5pt; font-weight: normal; font-style: italic; margin: 2pt 0 0; line-height: 1.2; }\n.dbl { border: 0; border-top: .6pt solid #000; height: 0; margin-top: 5pt; }\n.hp-header, .info-header { border-bottom: .6pt solid #000; padding-bottom: 5pt; }\n/* Metadata and narrative layouts are borderless. Original HTML remains intact. */\n.kv, .refbox, .hp-meta-table { table-layout: fixed; border: 0; margin: 4pt 0 6pt; }\n.kv td, .refbox td, .hp-meta-table td { border: 0; background: transparent; padding: 2pt 4pt; }\n.kv .l { width: 30%; font-weight: normal; background: transparent; }\n.kv .v, .refbox .rv { font-weight: bold; }\n.refbox .rl { display: block; font-size: 9pt; font-style: italic; }\n.refbox .rv { display: block; font-size: 10pt; min-height: 12pt; }\n.hp-meta-table td:first-child { width: 15% !important; }\n.hp-meta-table td:nth-child(2) { width: 42% !important; }\n.hp-meta-table td:nth-child(3) { width: 18% !important; }\n.hp-meta-table td:nth-child(4) { width: 25% !important; }\n/* Only goods and financial details receive restrained rules. */\n.key, .key-terms, .fin, .goods, .hp-data-table {\n  width: 100%; border-collapse: collapse; margin: 5pt 0 7pt; border: .5pt solid #888;\n  font-size: 10pt; line-height: 1.2;\n}\n.key, .key-terms, .fin, .goods { table-layout: fixed; }\n.key, .key-terms { page-break-inside: avoid; }\n.key th, .key-terms th, .goods th, .hp-data-table th {\n  font-size: 9.5pt; background: #eee; color: #000; font-weight: bold;\n  text-align: left; padding: 3pt 4pt; border: .5pt solid #888;\n}\n.key td, .key-terms td { padding: 4pt; border-right: .5pt solid #888; vertical-align: top; }\n.k-label { font-size: 9pt; font-style: italic; line-height: 1.15; margin-bottom: 2pt; }\n.k-val { font-size: 10.5pt; font-weight: bold; line-height: 1.2; white-space: normal; overflow-wrap: break-word; }\n.k-sub { font-size: 9pt; font-style: italic; margin-top: 1pt; }\n.fin td, .goods td, .hp-data-table td { padding: 2.5pt 4pt; border: .5pt solid #aaa; }\n.fin .r { width: 10mm; font-weight: bold; text-align: center; white-space: nowrap; }\n.fin .cur { width: 7mm; text-align: right; padding-right: 2pt; border-right: 0; }\n.fin .amt { width: 32mm; text-align: right; font-weight: bold; white-space: nowrap; border-left: 0; }\n.fin tr.strong td { border-top: 1pt solid #000; background: #eee; font-weight: bold; }\n.fin tr.hl td { background: #f3f3f3; font-weight: bold; }\n.goods .no { width: 10mm; text-align: center; }\n.goods .q { width: 14mm; text-align: center; }\n.goods .p { width: 30mm; text-align: right; white-space: nowrap; }\n.goods td { height: 15pt; }\n.hp-data-table td, .hp-data-table th { color: #000 !important; }\n.hp-data-table tr[style] { background-color: #f3f3f3 !important; }\n/* Compact narrative sections with hanging numbers; no flex/grid dependency. */\n.sec, .section-category {\n  font-size: 10pt; font-weight: bold; text-transform: uppercase; letter-spacing: .02em;\n  text-align: left; margin: 8pt 0 4pt; padding: 0 0 2pt; border: 0;\n  border-bottom: .5pt solid #777; background: transparent;\n}\n.lead { font-size: 10pt !important; line-height: 1.25; margin: 0 0 5pt; }\n.cl { font-size: 10pt !important; margin: 0 0 4pt; padding-left: 9mm; position: relative; page-break-inside: auto; }\n.cl .n { position: absolute; left: 0; top: 0; width: 8mm; font-weight: bold; }\n.cl .h { font-weight: bold; margin-bottom: 2pt; }\n.cl p { margin: 0 0 3pt; text-align: left; }\n.cl ul { margin: 2pt 0 3pt; padding-left: 14pt; }\n.cl li { margin-bottom: 2pt; text-align: left; }\n.sub { padding-left: 7mm; margin: 0 0 3pt; text-align: left; }\n.qa-block { display: block; position: relative; padding-left: 7mm; margin-bottom: 6pt; page-break-inside: auto; break-inside: auto; }\n.qa-number { position: absolute; left: 0; top: 0; width: 6mm; font-size: 10pt; font-weight: bold; }\n.qa-content { display: block; }\n.qa-question { font-size: 10pt; font-weight: bold; margin-bottom: 2pt; }\n.qa-answer { text-align: left; orphans: 3; widows: 3; }\n.qa-answer ul { margin: 3pt 0; padding-left: 16pt; }\n.hp-legal-clauses { font-size: 10pt; line-height: 1.2; text-align: left; margin-top: 6pt; padding-top: 4pt; border-top: .5pt solid #777; }\n.hp-clause { display: block; position: relative; padding-left: 7mm; margin-bottom: 4pt; orphans: 3; widows: 3; }\n.hp-clause-num { position: absolute; left: 0; top: 0; width: 6mm; font-weight: bold; }\n.hp-clause-text { display: block; }\n/* Legal warning emphasis is retained; not treated as a layout border. */\n.notice { border: 2.25pt solid #000; padding: 7pt 10pt; margin: 8pt 0; text-align: center; font-weight: bold; page-break-inside: avoid; }\n.notice .nt { font-size: 11pt; letter-spacing: .04em; margin-bottom: 4pt; }\n.notice-soft { border: 1.5pt solid #000; padding: 6pt 10pt; margin: 8pt 0; page-break-inside: avoid; }\n.notice-soft .nt { font-weight: bold; text-align: center; margin-bottom: 4pt; border-bottom: .75pt solid #000; padding-bottom: 3pt; }\n.notice-soft p { margin-bottom: 3pt; }\n.hp-notice-box, .statutory-notice-box {\n  border: 1.5px solid #000; background: #fafafa; padding: 7pt 9pt;\n  margin: 8pt 0; font-size: 10pt; line-height: 1.25; page-break-inside: avoid; break-inside: avoid;\n}\n.statutory-notice-box strong { display: block; margin-bottom: 3pt; }\n/* Preserve intentional execution-page breaks pending legal/operational approval. */\n.hp-page-two-container { page-break-before: always; margin-top: 0; }\n.pagebreak, .page-break { page-break-before: always; break-before: page; }\n/* Signature areas remain usable on paper; no content is conditionally hidden. */\n.sign { table-layout: fixed; margin-top: 8pt; page-break-inside: avoid; }\n.sign td { padding: 0 10pt 0 0; vertical-align: top; border: 0; }\n.sign td:last-child { padding-right: 0; }\n.sign .who { font-weight: bold; text-transform: uppercase; font-size: 9.5pt; letter-spacing: .02em; margin-bottom: 3pt; }\n.sign .box { height: 20mm; border-bottom: .75pt solid #000; }\n.sign .cap { font-size: 9pt; font-style: italic; margin-top: 2pt; }\n.sign .line { margin-top: 4pt; border-bottom: .5pt solid #888; padding-bottom: 1pt; min-height: 13pt; }\n.sign .line span { font-size: 9pt; font-style: italic; }\n.sig-img { max-width: 100%; max-height: 18mm; display: block; }\n.signature-container, .hp-signature-block { margin-top: 8pt; width: 100%; page-break-inside: auto; break-inside: auto; }\n.ack-meta-panel { margin-top: 6pt; font-size: 10pt; line-height: 1.25; page-break-inside: avoid; }\n.signature-grid, .hp-sig-grid { display: block; width: 100%; margin-top: 3pt; }\n.signature-block, .hp-sig-cell {\n  display: inline-block; width: 47%; margin: 5pt 2% 5pt 0;\n  padding-top: 17mm; vertical-align: top; position: relative;\n  border: 0; font-size: 10pt; line-height: 1.25; page-break-inside: avoid; break-inside: avoid;\n}\n.signature-block:before, .hp-sig-cell:before {\n  content: \"\"; position: absolute; left: 0; right: 0; top: 16mm; border-top: .75pt solid #000;\n}\n.sig-image, .hp-sig-img { position: absolute; top: 0; bottom: auto; left: 0; max-width: 100%; max-height: 15mm; }\n.block, .avoid { page-break-inside: avoid; }\nhr { border: 0; border-top: .5pt solid #777; margin: 7pt 0; }\n.cira-authority-form p { margin-bottom: 5pt; }\n.cira-authority-form ~ img { max-width: 62mm !important; max-height: 20mm !important; }\n@media print {\n  @page { size: A4; margin: 12mm; }\n  body, .print-format { background: #fff; }\n  thead { display: table-header-group; }\n  tfoot { display: table-footer-group; }\n}\n\n</style>\n\n{% macro money(v) %}{{ \"{:,.2f}\".format((v or 0)|float) }}{% endmacro %}\n{% set period_label = doc.custom_flexi_payment_period or \"Monthly\" %}\n{% set period_key = period_label|lower|replace(\"-\", \"\")|replace(\" \", \"\") %}\n{% set count_map = {\"weekly\": doc.custom_flexi_weekly_instalments, \"fortnightly\": doc.custom_flexi_fortnightly_instalments, \"bimonthly\": doc.custom_flexi_bimonthly_instalments, \"monthly\": doc.custom_flexi_monthly_instalments} %}\n{% set amount_map = {\"weekly\": doc.custom_flexi_weekly_instalment_amount, \"fortnightly\": doc.custom_flexi_fortnightly_instalment_amount, \"bimonthly\": doc.custom_flexi_bimonthly_instalment_amount, \"monthly\": doc.custom_flexi_monthly_instalment_amount} %}\n{% set n_instalments = count_map.get(period_key) or doc.repayment_periods or \"\" %}\n{% set instalment_amount = amount_map.get(period_key) or doc.repayment_amount or 0 %}\n{% set addr_parts = [doc.address_line_1, (doc.address_line_2 if doc.address_line_2 != doc.address_line_1 else none), (doc.custom_suburb or doc.suburb), doc.city, (doc.custom_province if doc.custom_province != doc.city else none), doc.country, (doc.zip_code if doc.zip_code and doc.zip_code != 0 else none)] %}\n{% set address = addr_parts|select|join(\", \") %}\n{% set items = doc.custom_flexi_purchase_items or [] %}\n{% set office = doc.company_registered_office or \"Lot 18 Yarawa Road, Nabua, Suva, Central Division, Fiji\" %}\n{% set hirer_signature = doc.hirer_signature or doc.custom_applicant_signature or \"\" %}\n{% set hirer_date = doc.hirer_signature_date or doc.custom_flexi_hirer_signature_date or \"\" %}\n{% set rep_name = doc.company_representative_name or doc.custom_flexi_company_representative_name or \"\" %}\n{% set rep_signature = doc.company_representative_signature or doc.custom_flexi_company_representative_signature or \"\" %}\n{% set rep_date = doc.company_representative_date or doc.custom_flexi_company_representative_date or \"\" %}\n{% set co_applicants = get_co_applicants(doc.name) %}\n{% set has_co_applicants = co_applicants|length > 0 %}\n{# Print-only joint name: reuse the co-applicant list already retrieved above. #}\n{% set joint = namespace(name=(doc.applicant_name or '')) %}\n{% if has_co_applicants %}\n    {% for co_applicant in co_applicants %}\n        {% set co_name = applicant_name(co_applicant) %}\n        {% if co_name %}\n            {% set joint.name = joint.name ~ (' & ' if joint.name else '') ~ co_name %}\n        {% endif %}\n    {% endfor %}\n{% endif %}\n{% set hirer_names = joint.name %}\n\n<div class=\"hp-contract-body\">\n    \n    <!-- PAGE 1: DEALS, ITEMS, FINANCIALS & CLAUSES -->\n    <div class=\"hp-header\">\n        <h2>Comfort Home Furnishing Pte Limited</h2>\n        <h3>TRADING AS FLEXIBLE PURCHASE</h3>\n        <h4>Hire Purchase Agreement</h4>\n    </div>\n\n    <!-- Deal Parties & Meta -->\n    <table class=\"hp-meta-table\">\n        <tr>\n            <td style=\"width: 10%;\"><strong>Owner:</strong></td>\n            <td style=\"width: 48%;\">COMFORT HOME FURNISHING PTE LIMITED TRADING AS FLEXIBLE PURCHASE<br><small>{{ office }}</small></td>\n            <td style=\"width: 17%;\"><strong>HP Account No:</strong></td>\n            <td style=\"width: 25%;\">{{ doc.custom_flexi_hp_account_number or \"\" }}</td>\n        </tr>\n        <tr>\n            <td><strong>Hirer/Borrower:</strong></td>\n            <td>{{ hirer_names }}<br><small>{{ address }}</small></td>\n            <td><strong>Quotation No:</strong></td>\n            <td>{{ doc.custom_flexi_quotation_number or \"\" }}</td>\n        </tr>\n    </table>\n\n    <div style=\"font-size: 10pt; margin-bottom: 12px;\">\n        <strong>BETWEEN:</strong> COMFORT HOME FURNISHING PTE LIMITED TRADING AS FLEXIBLE PURCHASE (the \"Owner\") and the Hirer named above. The Owner agrees to let and the Hirer agrees to hire the chattels described below subject to the parameters set forth in this Credit Contract.\n    </div>\n    \n    <div class=\"hp-legal-clauses\">\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">1.</span>\n            <span class=\"hp-clause-text\">The Hirer shall pay the total sum of $ <b>{{ money(doc.total_payable_amount) }}</b>, which sum is inclusive of principal, interest, and other charges for the term of the Hire.</span>\n        </div>\n    </div>\n    \n    <!-- Table 1: Key Terms Summary -->\n     <table class=\"key-terms\">\n        <tr><th colspan=\"5\">1.a. Key terms of this agreement</th></tr>\n            <tr>\n            <td style=\"width:20%;\"><div class=\"k-label\">Total Payable:</div><div class=\"k-val\">$ {{ money(doc.total_payable_amount) }}</div></td>\n            <td style=\"width:20%;\"><div class=\"k-label\">Each Installment:</div><div class=\"k-val\">$ {{ money(instalment_amount) }}</div><div class=\"k-sub\">{{ period_label|lower }}</div></td>\n            <td style=\"width:20%;\"><div class=\"k-label\">Number of Installments:</div><div class=\"k-val\">{{ n_instalments }}</div><div class=\"k-sub\">Over: {{ doc.custom_flexi_term_months or \"\" }} months</div></td>\n            <td style=\"width:20%;\"><div class=\"k-label\">First Installment:</div><div class=\"k-val\">{{ frappe.utils.formatdate(doc.custom_flexi_first_instalment_date, \"dd-mm-yyyy\") if doc.custom_flexi_first_instalment_date else \"\" }}</div></td>\n            <td style=\"width:20%;\"><div class=\"k-label\">Annual Interest Rate:</div><div class=\"k-val\">{{ doc.custom_flexi_interest_rate or \"\" }}%</div><div class=\"k-sub\">fixed for the term</div></td>\n    </tr></table>\n\n\n    <!-- Table 2: Description of Goods -->\n    <table class=\"hp-data-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 80%;\">2. Description of Goods</th>\n                <th style=\"width: 20%; text-align: center;\">Qty</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in items %}\n            <tr>\n                <td style=\"text-align: left;\">{{ loop.index }},{{ item.product_description or \"\" }}</td>\n                <td style=\"text-align: center;\">{{ item.quantity if item.quantity is not none else \"\" }}</td>\n            </tr>\n            {% else %}\n            <tr>\n                <td colspan=\"3\" style=\"text-align: center; font-style: italic; padding: 10px;\">No items specified</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- Table 3: Financial Terms Breakdown -->\n    <table class=\"hp-data-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 75%;\">3. Financial Statement Element (Clause 3 Payments)</th>\n                <th style=\"width: 25%; text-align: right;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td>I. Cost of Goods (Cash Price)</td>\n                <td style=\"text-align: right;\">$ {{ money(doc.custom_flexi_cash_price) }}</td>\n            </tr>\n            <tr>\n                <td>II. Deposit</td>\n                <td style=\"text-align: right; color: #b91c1c;\">$ {{ money(doc.custom_flexi_deposit_amount) }}</td>\n            </tr>\n            <tr>\n                <td>III. Balance After Deposit</td>\n                <td style=\"text-align: right; font-weight: bold;\">$ {{ money(doc.custom_flexi_value_after_deposit) }}</td>\n            </tr>\n            <tr>\n                <td>IV. Documentation Fees</td>\n                <td style=\"text-align: right;\">$ {{ money(doc.custom_flexi_documentation_fee) }}</td>\n            </tr>\n            <tr>\n                <td>V. Admin Fees</td>\n                <td style=\"text-align: right;\">$ {{ money(doc.custom_flexi_admin_fee) }}</td>\n            </tr>\n            <tr>\n                <td>VI. Interest Charges</td>\n                <td style=\"text-align: right;\">$ {{ money(doc.total_payable_interest) }}</td>\n            </tr>\n            <tr style=\"background-color: #f9fafb; font-weight: bold;\">\n                <td>VII. Total Payable (Contract Sum)</td>\n                <td style=\"text-align: right;\">$ {{ money(doc.total_payable_amount) }}</td>\n            </tr>\n            <tr style=\"background-color: #f0f7ff; font-weight: bold;\">\n                <td style=\"color: #1e40af;\">VIII. {{ period_label }} Installment ({{ n_instalments }} payments)</td>\n                <td style=\"text-align: right; color: #1e40af;\">$ {{ money(instalment_amount) }}</td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Legal Terms & Conditions List -->\n    <div class=\"hp-legal-clauses\">\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">4.</span>\n            <span class=\"hp-clause-text\">In the event the Hirer defaults in any one payment, then the Hirer shall be liable to pay a default interest rate of 2.2% on the unpaid amount. Such interest shall accrue from the date of the default till the total amount in default is cleared in full.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">5.</span>\n            <span class=\"hp-clause-text\">The Chattels, being the subject of this agreement, shall remain the property of the Owner till such time when all the payments specified in clauses 3 and 4 have been duly paid (provided always that the terms and conditions of this agreement have in the meantime been duly observed by the hirer). The Hirer shall be a mere Bailee of the chattels till such time as the chattels are fully paid for.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">6.</span>\n            <span class=\"hp-clause-text\">The Hirer shall keep the Chattels in good order and in working condition at the Hirer's address (any change of which shall be promptly notified to the Owner in writing) and which may be inspected by the Owner and or its agent at all reasonable times.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">7.</span>\n            <span class=\"hp-clause-text\">The Hirer shall not sell, assign, transfer, pledge, mortgage, or otherwise deal with or part with the possession of the said chattels or any of the benefits of this agreement nor commit or suffer the chattels to be seized under distress for rent, rates taxes or any other legal process.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">8.</span>\n            <span class=\"hp-clause-text\">If the said chattels shall during the hiring become damaged, defective or unserviceable, the hirer shall report such fact to the Owner who may at the expense of the Hirer repair, make good or cause to be repaired the said chattels and the Hirer on demand by the Owner shall deliver the said chattels to the Owner for such purpose.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">9.</span>\n            <span class=\"hp-clause-text\">The Hirer shall have a right to terminate this agreement at any time by returning the chattels in good and working condition at his or her own expense to the Owner. The Hirer will be liable to pay to the Owner the shortfall balance or any balance owing after the market value consideration has been deducted from the balance owed at the time the chattels are returned.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">10.</span>\n            <span class=\"hp-clause-text\">If the Hirer commits breach of any term of this Agreement or fails to pay any two consecutive monthly instalments, and or defaults in the final payment the Owner will have the right to terminate this agreement and take possession of the chattels the subject of the hire by giving 21 DAYS prior notice to repossession and unless in the meanwhile the breach is remedied and the hire charges (default amount) are paid as the case may be, this agreement shall, on the expiration of the notice period stand terminated. If the agreement is terminated as aforesaid, the Hirer's option to purchase as hereinbefore mentioned shall stand forfeited or cancelled.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">11.</span>\n            <span class=\"hp-clause-text\">In the event the agreement is terminated due to the reason of default and non-payment of the hire charges by the Hirer, the Hirer shall continue to be liable to the Owner for all hire charges, default interest, fees, charges, and enforcement expenses due under the agreement.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">12.</span>\n            <span class=\"hp-clause-text\">The Hirer understands and agrees that the Owners, being the not Manufacturers of the chattels, do not supply the chattels or any of them subject to any condition or warranty either express or implied as to the quality, description fitness, suitability for use or otherwise.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">13.</span>\n            <span class=\"hp-clause-text\">The Hirer agrees that the risk in the chattels passes to the Hirer at the time of delivery and or possession of the chattels, and the Hirer must insure the chattels to cover all risks to the full replacement value of the chattels.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">14.</span>\n            <span class=\"hp-clause-text\">In the event of any loss or damage to the chattels by any means whatsoever, the Hirer remains liable to the Owner for the monthly payments and the contract sum.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">15.</span>\n            <span class=\"hp-clause-text\">No relaxation, delay or indulgence on the part of the Owner in enforcing any terms and conditions of this agreement shall prejudice or be deemed to be the waiver of any rights of the Owner under this agreement and or operate as a waiver of any breach of agreement.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">16.</span>\n            <span class=\"hp-clause-text\">This agreement shall only become binding upon acceptance and signing by the Owner and or its authorized representatives.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">17.</span>\n            <span class=\"hp-clause-text\">The Owner reserves the right to terminate this agreement and take possession of any chattels under this agreement if any information originally tendered in the application by the Hirer is later confirmed by the Owner to be false.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">18.</span>\n            <span class=\"hp-clause-text\">The Hirer shall pay to the owner on demand: a) All cost of locating the hirer or the Goods if the account is in default; b) All cost or recovering possession of Goods or any amount payable under this contract including any bailiff fee etc.; c) All Value added tax, Stamp duty, or other taxes or duties payable by the owner in respect of this agreement on the supply of Goods and Services; d) All costs, duties and taxes referred to above or other fees, charges, duties that may be introduced, and interest on arrears may be debited to hirer's account when they accrue. The Hirer can also be charged for the issuance of arrears letters, reminder letters or demand letters or other associated costs where accounts can be passed to external parties for debt of outstanding amounts.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">19.</span>\n            <span class=\"hp-clause-text\">The owner shall be liberty to transfer any credit balance from any of the hirer's paid off contract to the hirer's existing account which may be having due or arrears with or without consent of the hirer provided that such credit balance is not transferred to third party's account in which any case the owner shall ask for written confirmation from the hirer.</span>\n        </div>\n        <div class=\"hp-clause\">\n            <span class=\"hp-clause-num\">20.</span>\n            <span class=\"hp-clause-text\">The Hirer may take insurance cover to insure the chattels and shall provide the certificate of covering stating the terms and conditions thereof.</span>\n        </div>\n    </div>\n\n    <!-- PAGE 2: STATUTORY WARNING NOTICE & SIGNATURE EXECUTION PANELS -->\n    <div class=\"hp-page-two-container\">\n        \n        <div class=\"hp-notice-box\">\n            <strong style=\"font-size: 10pt; text-transform: uppercase; display: block; margin-bottom: 4px;\">IMPORTANT NOTICE: THINGS YOU MUST KNOW BEFORE YOU SIGN</strong>\n            READ THIS HIRE PURCHASE AGREEMENT so that you know exactly what you are entering into and what you will have to do under the agreement. \n            Once you sign the agreement, you will be bound by it. However, you may end the agreement before you obtain (or try to obtain) any credit by informing COMFORT HOME FURNISHING PTE LIMITED TRADING AS FLEXIBLE PURCHASE in writing, but you will still be liable for any fees or charges incurred.\n            You acknowledge that you have been advised by COMFORT HOME FURNISHING PTE LIMITED TRADING AS FLEXIBLE PURCHASE that you may consult with an insurance agent on the option of taking out an insurance cover for the product. If you take out insurance, the credit provider cannot insist on any particular insurance company. Fill in or cross out any blank spaces. Get a copy of this agreement document. \n            <strong>DO NOT SIGN this agreement document if there is anything you do not understand.</strong>\n        </div>\n\n        <div class=\"hp-signature-block\">\n            <div class=\"hp-sig-grid\">\n                \n                <!-- Hirer Signature Cell -->\n                <div class=\"hp-sig-cell\">\n                    {% if hirer_signature %}\n                    <img src=\"{{ hirer_signature }}\" class=\"hp-sig-img\" alt=\"Hirer Signature\">\n                    {% endif %}\n                    <strong>Signature of Hirer / Borrower</strong><br>\n                    Name: {{ doc.applicant_name or \"\" }}<br>\n                    Date: {% set final_hirer_date = hirer_date or frappe.utils.nowdate() %} {{ frappe.utils.formatdate(final_hirer_date, \"dd-MM-yyyy\") }}\n                </div>\n\n                <!-- Company Representative Signature Cell -->\n                <div class=\"hp-sig-cell\">\n                    {% if rep_signature %}\n                    <img src=\"{{ rep_signature }}\" class=\"hp-sig-img\" alt=\"Representative Signature\">\n                    {% endif %}\n                    <strong>Signed for CHFPL T/A Flexible Purchase</strong><br>\n                    Manager / Director: {{ rep_name }}<br>\n                    Date: {% set final_rep_date = rep_date or frappe.utils.nowdate() %} {{ frappe.utils.formatdate(final_rep_date, \"dd-MM-yyyy\") }}\n                </div>\n\n                <!-- Dynamic Co-Applicant / Co-Hirer Fields -->\n                {% if has_co_applicants %}\n                    {% for co_applicant in co_applicants %}\n                    <div class=\"hp-sig-cell\">\n                        {% if co_applicant.custom_applicant_signature %}\n                        <img src=\"{{ co_applicant.custom_applicant_signature }}\" class=\"hp-sig-img\" alt=\"Co-Hirer Signature\">\n                        {% endif %}\n                        <strong>Signature of Co-Hirer / Co-Borrower</strong><br>\n                        Name: {{ applicant_name(co_applicant) }}<br>\n                        Date: {{ frappe.utils.formatdate(co_applicant.custom_flexi_hirer_signature_date, \"dd-MM-yyyy\") if co_applicant.custom_flexi_hirer_signature_date else \"\" }}\n                    </div>\n                    {% endfor %}\n                {% endif %}\n\n            </div>\n        </div>\n\n    </div>\n\n</div>",
