-----------\n\ndoc.hp_account_no = (\n    doc.custom_flexi_hp_account_number\n    or doc.name\n)\n\ndoc.hp_reference_no = (\n    doc.custom_flexi_quotation_number\n    or \"\"\n)\n\ndoc.hirer_signature = (\n    doc.custom_applicant_signature\n    or \"\"\n)\n\ndoc.hirer_signature_date = (\n    doc.custom_flexi_hirer_signature_date\n    or None\n)\n\ndoc.company_representative_name = (\n    doc.custom_flexi_company_representative_name\n    or \"\"\n)\n\ndoc.company_representative_signature = (\n    doc.custom_flexi_company_representative_signature\n    or \"\"\n)\n\ndoc.company_representative_date = (\n    doc.custom_flexi_company_representative_date\n    or None\n)\n\n\n# ------------------------------------------------------------\n# Company registered office\n# ------------------------------------------------------------\n\ncompany_addresses = frappe.get_all(\n    \"Address\",\n    filters={\n        \"is_your_company_address\": 1\n    },\n    fields=[\n        \"address_line1\",\n        \"address_line2\",\n        \"city\",\n        \"state\",\n        \"country\"\n    ],\n    limit_page_length=1\n)\n\naddress_parts = []\n\nif company_addresses:\n\n    address = company_addresses[0]\n\n    if address.get(\"address_line1\"):\n        address_parts.append(address.get(\"address_line1\"))\n\n    if address.get(\"address_line2\"):\n        address_parts.append(address.get(\"address_line2\"))\n\n    if address.get(\"city\"):\n        address_parts.append(address.get(\"city\"))\n\n    if address.get(\"state\"):\n        address_parts.append(address.get(\"state\"))\n\n    if address.get(\"country\"):\n        address_parts.append(address.get(\"country\"))\n\ndoc.company_registered_office = \", \".join(\n    address_parts\n)\n\n\n# ------------------------------------------------------------\n# Regenerate agreement AFTER signature is saved\n# ------------------------------------------------------------\n\nhtml = frappe.get_print(\n    \"Loan Application\",\n    doc.name,\n    print_format=\"Hire Purchase Agreement\",\n    doc=doc\n)\n\n\n# Freeze newly rendered signed version\nfrappe.db.set_value(\n    \"Loan Customer Agreement\",\n    rowname,\n    {\n        \"generated_html\": html,\n        \"generated_on\": signed_on\n    }\n)\n\nfrappe.db.commit()\n\n\nfrappe.response[\"message\"] = {\n    \"status\": \"Customer Signed\",\n    \"html\": html\n}\n",
