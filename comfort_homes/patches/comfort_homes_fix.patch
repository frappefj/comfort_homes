n    { income_type: \"Overtime\", description: \"Overtime or commission\" },\n    { income_type: \"Self-employed Income\" },\n    { income_type: \"Rental Income\", description: \"Rental or taxi income\" },\n    { income_type: \"Other Income\", description: \"Other regular income\" }\n];\n\nconst defaultContactRows = [\n    { contact_type: \"Family Relative\", relationship: \"Family Relative 1\" },\n    { contact_type: \"Family Relative\", relationship: \"Family Relative 2\" },\n    { contact_type: \"Office Referee\", relationship: \"Office Referee 1\" },\n    { contact_type: \"Office Referee\", relationship: \"Office Referee 2\" }\n];\n\nconst defaultObligationRows = [\n    { obligation_type: \"Housing Loan\", payment_method: \"Payroll Deduction\" },\n    { obligation_type: \"Personal Loan\", payment_method: \"Payroll Deduction\" },\n    { obligation_type: \"Motor Vehicle Loan\", payment_method: \"Payroll Deduction\" },\n    { obligation_type: \"Hire Purchase\", provider: \"Enter provider\" },\n    { obligation_type: \"Bank Loan\", provider: \"Enter bank\" },\n    { obligation_type: \"Credit Card\", provider: \"Enter provider\" },\n    { obligation_type: \"Other\", provider: \"Other financial obligation\" }\n].map((row) => ({ ...row, frequency: \"Weekly\" }));\n\nconst defaultDocumentRows = [\n    \"Identity Document\", \"Latest Payslip\", \"Bank Statement\",\n    \"Proof of Address\", \"Supplier Quotation\", \"Other Supporting Document\"\n].map((document_type) => ({ document_type }));\n\nconst monthlyFactor = (frequency) => ({\n    \"Weekly\": 52 / 12,\n    \"Fortnightly\": 26 / 12,\n    \"Bi-monthly\": 2,\n    \"Monthly\": 1\n}[frequency] || 1);\n\nconst money = (value) => Math.round((Number(value || 0) + Number.EPSILON) * 100) / 100;\nlet webFinanceSyncing = false;\n\nfunction webNumberValue(fieldname) {\n    const field = frappe.web_form.fields_dict[fieldname];\n    const input = field?.wrapper?.querySelector(\"input\");\n    const raw = input?.value ?? frappe.web_form.get_value(fieldname) ?? 0;\n    return Number(String(raw).replace(/,/g, \"\")) || 0;\n}\n\nfunction calculateIncomeAndExpenses() {\n    const incomeRows = frappe.web_form.get_value(\"custom_flexi_income_entries\") || [];\n    const expenseRows = frappe.web_form.get_value(\"custom_flexi_living_expenses\") || [];\n    const obligationRows = frappe.web_form.get_value(\"custom_flexi_finance_obligations\") || [];\n    const income = incomeRows.reduce((sum, row) => {\n        const exact = Number(row.amount || 0) * monthlyFactor(row.frequency);\n        row.monthly_amount = money(exact);\n        return sum + (row.income_type === \"Salary Deductions\" ? Math.abs(exact) : exact);\n    }, 0);\n    const expenses = expenseRows.reduce((sum, row) => {\n        const exact = Number(row.expense_amount || 0) * Number(row.frequency_per_month || 1);\n        row.monthly_amount = money(exact);\n        return sum + exact;\n    }, 0);\n    const obligations = obligationRows.reduce((sum, row) => {\n        const exact = Number(row.amount || 0) * monthlyFactor(row.frequency);\n        row.monthly_amount = money(exact);\n        return sum + (row.income_type === \"Salary Deductions\" ? -exact : exact);\n    }, 0);\n    frappe.web_form.set_value(\"custom_flexi_total_monthly_income\", money(income));\n    frappe.web_form.set_value(\"custom_flexi_total_annual_income\", money(income * 12));\n    frappe.web_form.set_value(\"custom_flexi_total_monthly_expenses\", money(expenses));\n    frappe.web_form.set_value(\"custom_flexi_net_monthly_income\", money(income - expenses));\n    frappe.web_form.set_value(\"custom_flexi_dsr_total_income\", money(income));\n    frappe.web_form.set_value(\"custom_flexi_total_finance_obligations\", money(obligations));\n    frappe.web_form.set_value(\"custom_flexi_dsr_net_income\", money(income - obligations));\n    const preDti = income ? money(obligations / income * 100) : 0;\n    const maxDsr = Number(frappe.web_form.get_value(\"custom_flexi_selected_dsr\") || 35);\n    frappe.web_form.set_value(\"custom_flexi_pre_dsr\", preDti);\n    frappe.web_form.set_value(\"custom_flexi_dsr_margin\", money(Math.max(maxDsr - preDti, 0)));\n    frappe.web_form.set_value(\"custom_flexi_weekly_eligibility\", money(Math.max((income * maxDsr / 100 - obligations) * 12 / 52, 0)));\n    calculateFinanceSummary(\"amount\", { income, obligations });\n    renderDtiMatrix(income, obligations);\n    renderApplicationReview();\n}\n\n\nfunction renderDtiMatrix(income, obligations) {\n    const field = frappe.web_form.fields_dict.custom_flexi_dti_matrix;\n    if (!field?.$wrapper) return;\n    const periods = [\n        [\"Weekly\", 12 / 52], [\"Fortnightly\", 12 / 26],\n        [\"Bi-Monthly\", 1 / 2], [\"Monthly\", 1]\n    ];\n    const rows = [\n        [\"Income Used for DTI\", income],\n        [\"Current Obligations\", obligations],\n        [\"Income After Current Obligations\", income - obligations],\n        [\"Pre-Application DTI\", income ? obligations / income * 100 : 0]\n    ];\n    const head = periods.map(([label]) => `<th>${label}</th>`).join(\"\");\n    const body = rows.map(([label, monthly], rowIndex) => {\n        const cells = periods.map(([, factor]) => {\n            const value = rowIndex === 3 ? monthly : monthly * factor;\n            return `<td>${rowIndex === 3 ? money(value).toFixed(2) + \"%\" : \"FJD \" + money(value).toLocaleString(undefined, {minimumFractionDigits: 2})}</td>`;\n        }).join(\"\");\n        return `<tr><th>${label}</th>${cells}</tr>`;\n    }).join(\"\");\n    field.$wrapper.html(`<div class=\"flexi-summary-table\"><h3>Pre-Application DTI (Debt to Income Ratio)</h3><div class=\"table-responsive\"><table><thead><tr><th>Assessment</th>${head}</tr></thead><tbody>${body}</tbody></table></div></div>`);\n}\n\nfunction renderHirePurchaseTable(values) {\n    const section = document.querySelector('[data-fieldname=\"custom_flexi_terms_section\"] .section-body');\n    if (!section) return;\n    const hiddenFields = [\n        \"custom_flexi_weekly_instalments\", \"custom_flexi_weekly_instalment_amount\",\n        \"custom_flexi_fortnightly_instalments\", \"custom_flexi_fortnightly_instalment_amount\",\n        \"custom_flexi_bimonthly_instalments\", \"custom_flexi_bimonthly_instalment_amount\",\n        \"custom_flexi_monthly_instalments\", \"custom_flexi_monthly_instalment_amount\"\n    ];\n    hiddenFields.forEach((fieldname) => {\n        const control = section.querySelector(`.frappe-control[data-fieldname=\"${fieldname}\"]`);\n        if (control) control.style.display = \"none\";\n    });\n\n    let container = section.querySelector(\".flexi-hp-options-table\");\n    if (!container) {\n        container = document.createElement(\"div\");\n        container.className = \"flexi-hp-options-table flexi-summary-table col-sm-12\";\n        section.appendChild(container);\n    }\n    const periods = [\n        [\"Weekly\", \"weekly\"], [\"Fortnightly\", \"fortnightly\"],\n        [\"Bi-Monthly\", \"bimonthly\"], [\"Monthly\", \"monthly\"]\n    ];\n    const header = periods.map(([label]) => `<th>${label}</th>`).join(\"\");\n    const countCells = periods.map(([, key]) =>\n        `<td>${values[`custom_flexi_${key}_instalments`] || 0}</td>`\n    ).join(\"\");\n    const amountCells = periods.map(([, key]) =>\n        `<td>FJD ${money(values[`custom_flexi_${key}_instalment_amount`] || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>`\n    ).join(\"\");\n    container.innerHTML = `<h3>Hire Purchase Repayment Options</h3>\n        <div class=\"table-responsive\"><table>\n            <thead><tr><th>Repayment Detail</th>${header}</tr></thead>\n            <tbody>\n                <tr><th>Number of Instalments</th>${countCells}</tr>\n                <tr><th>Instalment Amount</th>${amountCells}</tr>\n            </tbody>\n        </table></div>`;\n}\n\nfunction calculateFinanceSummary(source = \"amount\", assessment = {}) {\n    if (webFinanceSyncing) return;\n    webFinanceSyncing = true;\n    try {\n        const items = frappe.web_form.get_value(\"custom_flexi_purchase_items\") || [];\n        const purchaseValue = items.reduce((sum, row) => {\n            const lineTotal = money(Number(row.quantity || 0) * Number(row.unit_price || 0));\n            row.total_amount = lineTotal;\n            return sum + lineTotal;\n        }, 0);\n        const surchargeRate = Math.max(webNumberValue(\"custom_flexi_surcharge_rate\"), 0);\n        const surchargeAmount = money(purchaseValue * surchargeRate / 100);\n        const enteredPercent = webNumberValue(\"custom_flexi_deposit_percent\");\n        const enteredAmount = webNumberValue(\"custom_flexi_deposit_amount\");\n        // Preserve an amount entered by the applicant. When a percentage is\n        // entered, round its resulting deposit upward to the next whole FJD.\n        const depositAmount = source === \"percent\"\n            ? Math.min(Math.ceil(Math.max(purchaseValue * enteredPercent / 100, 0)), purchaseValue)\n            : Math.min(Math.max(enteredAmount, 0), purchaseValue);\n        const depositPercent = source === \"percent\"\n            ? enteredPercent\n            : (purchaseValue ? depositAmount / purchaseValue * 100 : 0);\n        const afterDeposit = Math.max(purchaseValue - depositAmount, 0) + surchargeAmount;\n        const documentationFee = Number(frappe.web_form.get_value(\"custom_flexi_documentation_fee\") || 25);\n        const adminFeeRate = Number(frappe.web_form.get_value(\"custom_flexi_admin_fee_rate\") || 2.5);\n        const adminFee = afterDeposit * adminFeeRate / 100;\n        const stampDuty = Number(frappe.web_form.get_value(\"custom_flexi_stamp_duty_fee\") || 0);\n        const otherFee = Number(frappe.web_form.get_value(\"custom_flexi_other_fee\") || 0);\n        const financed = purchaseValue ? afterDeposit + documentationFee + adminFee + stampDuty + otherFee : 0;\n        const months = Number(frappe.web_form.get_value(\"custom_flexi_term_months\") || 12);\n        const interestRate = Number(frappe.web_form.get_value(\"custom_flexi_interest_rate\") || 0);\n        const termCharges = financed * interestRate / 100 * months / 12;\n        const totalRepayment = financed + termCharges;\n        const counts = {\n            weekly: Math.round(months * 52 / 12),\n            fortnightly: Math.round(months * 26 / 12),\n            bimonthly: months * 2,\n            monthly: months\n        };\n        const weeklyAmount = counts.weekly ? totalRepayment / counts.weekly : 0;\n        const fortnightlyAmount = counts.fortnightly ? totalRepayment / counts.fortnightly : 0;\n        const bimonthlyAmount = counts.bimonthly ? totalRepayment / counts.bimonthly : 0;\n        const monthlyAmount = counts.monthly ? totalRepayment / counts.monthly : 0;\n        const selectedMonthly = ({\n            \"Weekly\": weeklyAmount * 52 / 12,\n            \"Fortnightly\": fortnightlyAmount * 26 / 12,\n            \"Bi-monthly\": bimonthlyAmount * 2,\n            \"Monthly\": monthlyAmount\n        })[frappe.web_form.get_value(\"custom_flexi_payment_period\")] || monthlyAmount;\n        const income = assessment.income ?? webNumberValue(\"custom_flexi_total_monthly_income\");\n        const obligations = assessment.obligations ?? webNumberValue(\"custom_flexi_total_finance_obligations\");\n        const maxDsr = webNumberValue(\"custom_flexi_selected_dsr\") || 35;\n        const weeklyEligibility = Math.max((income * maxDsr / 100 - obligations) * 12 / 52, 0);\n        const postDsr = income ? (obligations + selectedMonthly) / income * 100 : 0;\n        const assessed = income > 0 && totalRepayment > 0;\n        const eligible = assessed && weeklyAmount <= weeklyEligibility && postDsr <= maxDsr;\n        const values = {\n            custom_flexi_cash_price: money(purchaseValue),\n            custom_flexi_surcharge_amount: surchargeAmount,\n            custom_flexi_full_value: money(purchaseValue + surchargeAmount),\n            custom_flexi_deposit_amount: money(depositAmount),\n            custom_flexi_deposit_percent: money(depositPercent),\n            custom_flexi_value_after_deposit: money(afterDeposit),\n            loan_amount: money(financed),\n            custom_flexi_documentation_fee: money(documentationFee),\n            custom_flexi_admin_fee: money(adminFee),\n            custom_flexi_stamp_duty_fee: money(stampDuty),\n            custom_flexi_net_amount_financed: money(financed),\n            custom_flexi_term_charges: money(termCharges),\n            custom_flexi_total_receivable: money(totalRepayment),\n            custom_flexi_weekly_instalments: counts.weekly,\n            custom_flexi_weekly_instalment_amount: money(weeklyAmount),\n            custom_flexi_fortnightly_instalments: counts.fortnightly,\n            custom_flexi_fortnightly_instalment_amount: money(fortnightlyAmount),\n            custom_flexi_bimonthly_instalments: counts.bimonthly,\n            custom_flexi_bimonthly_instalment_amount: money(bimonthlyAmount),\n            custom_flexi_monthly_instalments: counts.monthly,\n            custom_flexi_monthly_instalment_amount: money(monthlyAmount),\n            custom_flexi_post_dsr: money(postDsr),\n            custom_flexi_eligibility_status: assessed ? (eligible ? \"Achieved\" : \"Not Achieved\") : \"Not Assessed\",\n            repayment_periods: counts.monthly,\n            repayment_amount: money(monthlyAmount),\n            total_payable_amount: money(totalRepayment),\n            total_payable_interest: money(termCharges)\n        };\n        Object.entries(values).forEach(([fieldname, value]) => {\n            if (frappe.web_form.fields_dict[fieldname]) {\n                frappe.web_form.set_value(fieldname, value);\n            }\n        });\n        renderHirePurchaseTable(values);\n        renderApplicationReview();\n    } finally {\n        window.setTimeout(() => { webFinanceSyncing = false; }, 100);\n    }\n}\n\nasync function applyLoanProductDefaults() {\n    const product =\n        frappe.web_form.get_value(\"loan_product\");\n\n    if (!product) return;\n\n    try {\n        const response = await frappe.call({\n            method: \"get_loan_products\"\n        });\n\n        const products = response.message || [];\n\n        const data = products.find(\n            (row) => row.name === product\n        );\n\n        if (!data) return;\n\n        if (data.rate_of_interest !== undefined) {\n            frappe.web_form.set_value(\n                \"custom_flexi_interest_rate\",\n                Number(data.rate_of_interest || 0)\n            );\n        }\n\n        calculateFinanceSummary();\n\n    } catch (error) {\n        console.error(\n            \"Unable to load Loan Product defaults\",\n            error\n        );\n    }\n}\n\nasync function loadLoanProducts() {\n    const field = frappe.web_form.fields_dict.loan_product;\n    if (!field) return;\n\n    try {\n        const response = await frappe.call({\n            method: \"get_loan_products\"\n        });\n\n        const products = response.message || [];\n\n        if (!products.length) {\n            console.warn(\"No Loan Products returned.\");\n            return;\n        }\n\n        const currentValue =\n            frappe.web_form.get_value(\"loan_product\") || \"\";\n\n        field.df.options = [\n            \"\",\n            ...products.map(row => row.name)\n        ].join(\"\\n\");\n\n        field.refresh();\n\n        if (\n            currentValue &&\n            products.some(row => row.name === currentValue)\n        ) {\n            frappe.web_form.set_value(\n                \"loan_product\",\n                currentValue\n            );\n        }\n    } catch (error) {\n        console.error(\"Loan Product load failed\", error);\n    }\n}\n\nfunction renderApplicationReview() {\n    const field = frappe.web_form.fields_dict.custom_flexi_review_html;\n    if (!field?.$wrapper) return;\n    const value = (name, fallback=\"—\") => frappe.web_form.get_value(name) || fallback;\n    const rows = [\n        [\"Applicant\", value(\"applicant_name\")], [\"Email\", value(\"applicant_email_address\")],\n        [\"Phone\", value(\"applicant_phone_number\")], [\"Loan Product\", value(\"loan_product\")],\n        [\"Requested Loan Amount\", `FJD ${money(value(\"loan_amount\", 0)).toLocaleString(undefined, {minimumFractionDigits: 2})}`],\n        [\"Total Purchase Value\", `FJD ${money(value(\"custom_flexi_cash_price\", 0)).toLocaleString(undefined, {minimumFractionDigits: 2})}`],\n        [\"Total Value to be Financed\", `FJD ${money(value(\"custom_flexi_net_amount_financed\", 0)).toLocaleString(undefined, {minimumFractionDigits: 2})}`],\n        [\"Repayment Preference\", value(\"custom_flexi_payment_period\")]\n    ];\n    field.$wrapper.html(`<div class=\"flexi-review-grid\">${rows.map(([label, content]) => `<div><span>${label}</span><strong>${frappe.utils.escape_html(String(content))}</strong></div>`).join(\"\")}</div>`);\n}\n\nfunction calculateApplicantAge() {\n    const input = frappe.web_form.fields_dict.custom_flexi_date_of_birth?.wrapper?.querySelector(\"input\");\n    const value = input?.value || frappe.web_form.get_value(\"custom_flexi_date_of_birth\");\n    if (!value) {\n        frappe.web_form.set_value(\"custom_flexi_age\", 0);\n        return;\n    }\n    const parts = String(value).split(\"-\").map(Number);\n    if (parts.length !== 3 || parts.some((part) => !Number.isFinite(part))) return;\n    const year = parts[0] > 31 ? parts[0] : parts[2];\n    if (year < 1900 || year > new Date().getFullYear()) {\n        frappe.web_form.set_value(\"custom_flexi_age\", 0);\n        return;\n    }\n    const birth = parts[0] > 31\n        ? new Date(parts[0], parts[1] - 1, parts[2])\n        : new Date(parts[2], parts[1] - 1, parts[0]);\n    if (Number.isNaN(birth.getTime())) return;\n    const today = new Date();\n    let age = today.getFullYear() - birth.getFullYear();\n    if (today.getMonth() < birth.getMonth() ||\n        (today.getMonth() === birth.getMonth() && today.getDate() < birth.getDate())) age -= 1;\n    frappe.web_form.set_value(\"custom_flexi_age\", Math.max(age, 0));\n}\n\nfunction syncStandardAddressFields() {\n    const city = frappe.web_form.get_value(\"custom_new_city\") || \"\";\n    const province = frappe.web_form.get_value(\"custom_province\") || \"\";\n    if (frappe.web_form.get_value(\"city\") !== city) {\n        frappe.web_form.set_value(\"city\", city);\n    }\n    if (frappe.web_form.get_value(\"state\") !== province) {\n        frappe.web_form.set_value(\"state\", province);\n    }\n}\n\nfunction makeCalculatedFieldsReadOnly() {\n    const readOnlyFields = [\n        \"repayment_periods\",\n        \"custom_flexi_total_monthly_income\",\n        \"custom_flexi_total_annual_income\",\n        \"custom_flexi_cash_price\",\n        \"custom_flexi_value_after_deposit\",\n        \"custom_flexi_admin_fee\",\n        \"custom_flexi_net_amount_financed\",\n        \"custom_flexi_term_charges\",\n        \"custom_flexi_total_receivable\",\n        \"custom_flexi_post_dsr\",\n        \"custom_flexi_eligibility_status\"\n    ];\n\n    readOnlyFields.forEach((fieldname) => {\n        const field = frappe.web_form.fields_dict[fieldname];\n        if (!field) return;\n\n        field.df.read_only = 1;\n        field.refresh();\n    });\n}\n\nasync function initializeWebForm() {\n    frappe.defaults = frappe.defaults || {};\n    frappe.defaults.get_user_default = frappe.defaults.get_user_default || (() => null);\n    frappe.defaults.get_global_default = frappe.defaults.get_global_default || (() => null);\n    frappe.sys_defaults = frappe.sys_defaults || {};\n    frappe.sys_defaults.country = \"Fiji\";\n    setWebFormPhoneCountryDefaults();\n    makeCalculatedFieldsReadOnly();\n    // Website pages do not always receive the Desk system defaults, causing\n    // Frappe's Phone control to fall back to India (+91). Keep this Web Form\n    // and any Phone controls opened later in child-table rows on Fiji (+679).\n    frappe.sys_defaults = frappe.sys_defaults || {};\n    frappe.sys_defaults.country = \"Fiji\";\n    setWebFormPhoneCountryDefaults();\n    if (!frappe.web_form.get_value(\"posting_date\")) {\n        frappe.web_form.set_value(\"posting_date\", frappe.datetime.get_today());\n    }\n    seedTableRows(\"custom_flexi_application_contacts\", defaultContactRows);\n    seedTableRows(\"custom_flexi_income_entries\", defaultIncomeRows);\n    seedTableRows(\"custom_flexi_finance_obligations\", defaultObligationRows);\n    seedTableRows(\"documents\", defaultDocumentRows);\n    configureTablePhoneFields();\n    refreshAddressDropdowns();\n    syncStandardAddressFields();\n    seedTableRows(\n        \"custom_flexi_living_expenses\",\n        defaultLivingExpenseRows\n    );\n    calculateIncomeAndExpenses();\n    calculateApplicantAge();\n    applyLoanProductDefaults();\n    markSubmitRequiredFields();\n    updateSpouseRequirements();\n    bindTableCalculations();\n    bindPurchaseItemCalculations();\n    bindDepositCalculations();\n    bindSimpleSeededTableInputs();\n    bindApplicantDateCalculation();\n    bindSubmitValidation();\n    bindClickableSteps();\n    loadLoanProducts();\n}\n\nfunction configureTablePhoneFields() {\n    const contactField = frappe.web_form.fields_dict.custom_flexi_application_contacts;\n    if (!contactField?.grid) return;\n    contactField.grid.docfields.forEach((df) => {\n        if (![\"mobile_number\", \"home_phone\", \"employer_contact\"].includes(df.fieldname)) return;\n        df.fieldtype = \"Data\";\n        df.options = null;\n        df.placeholder = \"+679 123 4567\";\n    });\n    contactField.grid.refresh();\n}\n\nfunction setSelectOptions(fieldname, options) {\n    const field = frappe.web_form.fields_dict[fieldname];\n    if (!field) return;\n    field.df.options = [\"\", ...options].join(\"\\n\");\n    field.refresh();\n}\n\nfunction refreshAddressDropdowns() {\n    const province = frappe.web_form.get_value(\"custom_province\");\n    const city = frappe.web_form.get_value(\"custom_new_city\");\n    setSelectOptions(\"custom_province\", Object.keys(addressHierarchy).sort());\n    setSelectOptions(\"custom_new_city\", province ? Object.keys(addressHierarchy[province] || {}).sort() : []);\n    setSelectOptions(\"custom_suburb\", province && city ? (addressHierarchy[province]?.[city] || []) : []);\n}\n\nfunction setWebFormPhoneCountryDefaults() {\n    const phoneFields = [\n        \"applicant_phone_number\",\n        \"custom_flexi_employer_contact\",\n        \"custom_flexi_spouse_mobile\",\n        \"custom_flexi_spouse_employer_contact\"\n    ];\n    phoneFields.forEach((fieldname) => {\n        const field = frappe.web_form.fields_dict[fieldname];\n        if (!field || field.get_value() || !field.country_code_picker?.on_change) return;\n        field.country_code_picker.on_change(\"Fiji\", false);\n    });\n}\n\nfunction markSubmitRequiredFields() {\n    submitRequiredFields.forEach(([fieldname]) => {\n        const field = frappe.web_form.fields_dict[fieldname];\n        if (field && field.wrapper) field.wrapper.classList.add(\"flexi-submit-required\");\n    });\n}\n\nfunction updateSpouseRequirements() {\n    const field = frappe.web_form.fields_dict.custom_flexi_spouse_email;\n    if (!field?.wrapper) return;\n    field.wrapper.classList.toggle(\n        \"flexi-submit-required\",\n        frappe.web_form.get_value(\"custom_flexi_marital_status\") === \"Married\"\n    );\n}\n\nfunction setTableRows(fieldname, rows) {\n    const field = frappe.web_form.fields_dict[fieldname];\n    if (!field || !field.grid) return;\n    field.df.data = rows.map((row, index) => ({\n        ...row,\n        idx: index + 1,\n        __islocal: true\n    }));\n    field.grid.refresh();\n    frappe.web_form.make_form_dirty();\n}\n\nfunction seedTableRows(fieldname, rows) {\n    const existing = frappe.web_form.get_value(fieldname) || [];\n    const hasEnteredData = existing.some((row) => {\n        if (fieldname === \"custom_flexi_income_entries\") return Number(row.amount || 0) > 0;\n        if (fieldname === \"custom_flexi_living_expenses\") return Number(row.expense_amount || 0) > 0;\n        if (fieldname === \"custom_flexi_finance_obligations\") return Number(row.amount || 0) > 0;\n        if (fieldname === \"custom_flexi_application_contacts\") return Boolean(String(row.full_name || \"\").trim());\n        if (fieldname === \"documents\") return Boolean(String(row.file || \"\").trim());\n        return false;\n    });\n    if (!hasEnteredData) setTableRows(fieldname, rows);\n}\n\nfunction bindClickableSteps() {\n    const footer = $(\".web-form-footer\");\n    footer.off(\"click.flexiSteps keydown.flexiSteps\", \".slide-step\");\n    footer.on(\"click.flexiSteps keydown.flexiSteps\", \".slide-step\", function(event) {\n        if (event.type === \"keydown\" && ![\"Enter\", \" \"].includes(event.key)) return;\n        event.preventDefault();\n        const target = Number($(this).attr(\"data-step-id\"));\n        if (!Number.isInteger(target) || target < 0 || target > frappe.web_form.page_breaks.length) return;\n        frappe.web_form.current_section = target;\n        frappe.web_form.toggle_section();\n        window.scrollTo({ top: Math.max($(\".web-form-container\").offset().top - 20, 0), behavior: \"smooth\" });\n    });\n    $(\".slide-step\").attr({ role: \"button\", tabindex: \"0\" });\n}\n\n\n\n\nfunction bindDepositCalculations() {\n    const configurations = {\n        custom_flexi_deposit_amount: \"amount\",\n        custom_flexi_deposit_percent: \"percent\"\n    };\n    Object.entries(configurations).forEach(([fieldname, source]) => {\n        const field = frappe.web_form.fields_dict[fieldname];\n        if (!field?.wrapper || field.wrapper.dataset.flexiDepositBound) return;\n        field.wrapper.dataset.flexiDeposit