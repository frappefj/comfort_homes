-  "name": "Flexi Customer Document Signing",
-  "script": "function flexi_document_title(row) {\n    const titles = {\n        \"HP-AGREEMENT\": \"Hire Purchase Agreement\",\n        \"SCHEDULE-1\": \"Contents of Credit Contract\",\n        \"FORM-1\": \"Information Statement\",\n        \"FORM-2\": \"Form 2\",\n        \"FINANCIAL-OBLIGATIONS\": \"Summary of Financial Obligations\"\n    };\n    return titles[row.document_code] || row.document_code || \"Customer Document\";\n}\n\nfunction flexi_can_open_document(frm, row) {\n    const rows = frm.doc.custom_customer_documents || [];\n    const index = rows.findIndex(item => item.name === row.name);\n    if (index <= 0) return true;\n    const previous = rows[index - 1];\n    if (previous.status !== \"Completed\") {\n        frappe.msgprint(__(\"Please complete {0} before continuing.\", [flexi_document_title(previous)]));\n        return false;\n    }\n    return true;\n}\n\nfunction flexi_signature_fields(row, frm) {\n    const fields = [\n        { fieldname: \"document_reader\", fieldtype: \"HTML\" }\n    ];\n    if (row.document_code === \"HP-AGREEMENT\") {\n        fields.push(\n            { fieldtype: \"Section Break\", label: __(\"Agreement Reference\") },\n            {\n                fieldname: \"hp_reference_no\",\n                fieldtype: \"Data\",\n                label: __(\"HP Reference / Quotation No\"),\n                default: frm.doc.custom_flexi_quotation_number || \"\",\n                description: __(\"Enter the reference that must appear on the signed Hire Purchase Agreement.\")\n            }\n        );\n    }\n    fields.push(\n        { fieldtype: \"Section Break\", label: __(\"Customer Acknowledgement\") },\n        {\n            fieldname: \"acknowledged\",\n            fieldtype: \"Check\",\n            label: __(\"I confirm that I have read, understood and agree to this document.\"),\n            read_only: 1\n        },\n        { fieldtype: \"Section Break\", label: __(\"Customer Signature\") },\n        { fieldname: \"customer_signature\", fieldtype: \"Signature\", label: __(\"Draw Signature\") },\n        { fieldname: \"customer_signature_file\", fieldtype: \"Attach Image\", label: __(\"Or Attach Signature Image\") }\n    );\n    if (row.document_code === \"FORM-1\") {\n        fields.push(\n            { fieldtype: \"Section Break\", label: __(\"Witness Details\") },\n            { fieldname: \"witness_name\", fieldtype: \"Data\", label: __(\"Witness Name\"), default: frm.doc.custom_witness_name || \"\" },\n            { fieldname: \"witness_address\", fieldtype: \"Small Text\", label: __(\"Witness Address\"), default: frm.doc.custom_witness_address || \"\" },\n            { fieldname: \"witness_date\", fieldtype: \"Date\", label: __(\"Witness Date\"), default: frm.doc.custom_witness_date || frappe.datetime.get_today() },\n            { fieldname: \"witness_signature\", fieldtype: \"Signature\", label: __(\"Witness Signature\") }\n        );\n    }\n    return fields;\n}\n\nfunction flexi_open_customer_signing(frm, row) {\n    const title = flexi_document_title(row);\n    const dialog = new frappe.ui.Dialog({\n        title: __(title),\n        size: \"extra-large\",\n        fields: flexi_signature_fields(row, frm),\n        primary_action_label: __(\"Agree & Sign\"),\n        primary_action(values) {\n            if (!dialog.flexi_document_loaded) {\n                frappe.msgprint(__(\"The document is still loading.\"));\n                return;\n            }\n            if (!values.acknowledged) {\n                frappe.msgprint(__(\"Please scroll through the complete document before acknowledging it.\"));\n                return;\n            }\n            if (!values.customer_signature && !values.customer_signature_file) {\n                frappe.msgprint(__(\"Please draw your signature or attach a signature image.\"));\n                return;\n            }\n            if (row.document_code === \"FORM-1\" && (!values.witness_name || !values.witness_address || !values.witness_signature)) {\n                frappe.msgprint(__(\"Witness name, address and signature are required for the Information Statement.\"));\n                return;\n            }\n            frappe.call({\n                method: \"flexi_document_customer_sign\",\n                args: {\n                    docname: frm.doc.name,\n                    rowname: row.name,\n                    acknowledged: 1,\n                    signature: values.customer_signature || \"\",\n                    signature_file: values.customer_signature_file || \"\",\n                    witness_name: values.witness_name || \"\",\n                    witness_address: values.witness_address || \"\",\n                    witness_date: values.witness_date || \"\",\n                    witness_signature: values.witness_signature || \"\",\n                    hp_reference_no: values.hp_reference_no === undefined ? null : values.hp_reference_no\n                },\n                freeze: true,\n                freeze_message: __(\"Applying customer signature...\"),\n                callback(response) {\n                    const result = response.message || {};\n                    if (result.html && dialog.flexi_iframe) dialog.flexi_iframe.srcdoc = result.html;\n                    frappe.show_alert({\n                        message: result.status === \"Completed\" ? __(\"Signed copy attached to the Loan Application\") : __(\"Customer signature applied\"),\n                        indicator: \"green\"\n                    }, 6);\n                    dialog.set_primary_action(__(\"Close\"), () => {\n                        dialog.hide();\n                        frm.reload_doc();\n                    });\n                }\n            });\n        }\n    });\n    dialog.flexi_document_loaded = false;\n    dialog.show();\n    const wrapper = dialog.fields_dict.document_reader.$wrapper;\n    wrapper.html(`<div style=\"padding:40px;text-align:center;color:#6c7680;\">Preparing ${frappe.utils.escape_html(title)}...</div>`);\n\n    frappe.call({\n        method: \"flexi_document_preview\",\n        args: { docname: frm.doc.name, rowname: row.name },\n        callback(response) {\n            const result = response.message || {};\n            if (!result.html) {\n                wrapper.html('<div class=\"alert alert-danger\">No document content was returned.</div>');\n                return;\n            }\n            wrapper.empty();\n            const iframe = document.createElement(\"iframe\");\n            iframe.style.cssText = \"width:100%;height:65vh;border:1px solid #d1d8dd;background:#fff;display:block\";\n            iframe.srcdoc = result.html;\n            iframe.onload = () => {\n                dialog.flexi_document_loaded = true;\n                const acknowledgement = dialog.fields_dict.acknowledged;\n                const enableAcknowledgement = () => {\n                    acknowledgement.df.read_only = 0;\n                    acknowledgement.refresh();\n                };\n                try {\n                    const documentElement = iframe.contentDocument.documentElement;\n                    const body = iframe.contentDocument.body;\n                    const scroller = documentElement.scrollHeight >= body.scrollHeight ? documentElement : body;\n                    if (scroller.scrollHeight <= iframe.clientHeight + 10) {\n                        enableAcknowledgement();\n                    } else {\n                        iframe.contentWindow.addEventListener(\"scroll\", () => {\n                            const root = iframe.contentDocument.documentElement;\n                            const page = iframe.contentDocument.body;\n                            const top = Math.max(root.scrollTop, page.scrollTop);\n                            const height = Math.max(root.scrollHeight, page.scrollHeight);\n                            if (top + iframe.clientHeight >= height - 30) enableAcknowledgement();\n                        });\n                    }\n                } catch (error) {\n                    enableAcknowledgement();\n                }\n            };\n            dialog.flexi_iframe = iframe;\n            wrapper.append(iframe);\n            wrapper.append('<div style=\"font-size:12px;color:#6c7680;padding:8px 0 10px;\">Scroll to the end of the document to unlock acknowledgement and signing.</div>');\n        }\n    });\n}\n\nfunction flexi_open_director_signing(frm, row) {\n    const title = flexi_document_title(row);\n    const dialog = new frappe.ui.Dialog({\n        title: __(\"{0} - Company Sign\", [title]),\n        size: \"extra-large\",\n        fields: [\n            { fieldname: \"document_reader\", fieldtype: \"HTML\" },\n            { fieldtype: \"Section Break\", label: __(\"Director / Manager\") },\n            { fieldname: \"director_name\", fieldtype: \"Data\", label: __(\"Director / Manager Name\"), reqd: 1 },\n            { fieldname: \"director_signature\", fieldtype: \"Signature\", label: __(\"Draw Director / Manager Signature\") },\n            { fieldname: \"director_signature_file\", fieldtype: \"Attach Image\", label: __(\"Or Attach Signature Image\") }\n        ],\n        primary_action_label: __(\"Complete & Attach Signed Copy\"),\n        primary_action(values) {\n            if (!values.director_name || (!values.director_signature && !values.director_signature_file)) {\n                frappe.msgprint(__(\"Director / Manager name and signature are required.\"));\n                return;\n            }\n            frappe.call({\n                method: \"flexi_document_director_sign\",\n                args: {\n                    docname: frm.doc.name,\n                    rowname: row.name,\n                    director_name: values.director_name,\n                    director_signature: values.director_signature || \"\",\n                    director_signature_file: values.director_signature_file || \"\"\n                },\n                freeze: true,\n                freeze_message: __(\"Finalizing signed document...\"),\n                callback(response) {\n                    const result = response.message || {};\n                    if (result.html && dialog.flexi_iframe) dialog.flexi_iframe.srcdoc = result.html;\n                    frappe.show_alert({ message: __(\"Final signed copy attached to the Loan Application\"), indicator: \"green\" }, 6);\n                    dialog.set_primary_action(__(\"Close\"), () => {\n                        dialog.hide();\n                        frm.reload_doc();\n                    });\n                }\n            });\n        }\n    });\n    dialog.show();\n    const wrapper = dialog.fields_dict.document_reader.$wrapper;\n    wrapper.html('<div style=\"padding:40px;text-align:center;color:#6c7680;\">Preparing customer-signed document...</div>');\n    frappe.call({\n        method: \"flexi_document_preview\",\n        args: { docname: frm.doc.name, rowname: row.name },\n        callback(response) {\n            const result = response.message || {};\n            if (!result.html) {\n                wrapper.html('<div class=\"alert alert-danger\">Could not load the document.</div>');\n                return;\n            }\n            wrapper.empty();\n            const iframe = document.createElement(\"iframe\");\n            iframe.style.cssText = \"width:100%;height:65vh;border:1px solid #d1d8dd;background:#fff\";\n            iframe.srcdoc = result.html;\n            dialog.flexi_iframe = iframe;\n            wrapper.append(iframe);\n        }\n    });\n}\n\nfunction flexi_open_customer_document(frm, row) {\n    if (!flexi_can_open_document(frm, row)) return;\n    if (row.status === \"Completed\") {\n        if (row.final_signed_file) window.open(row.final_signed_file, \"_blank\");\n        else frappe.msgprint(__(\"The final signed copy is not available.\"));\n        return;\n    }\n    if (row.status === \"Customer Signed\" || row.status === \"Director Signed\") {\n        flexi_open_director_signing(frm, row);\n        return;\n    }\n    flexi_open_customer_signing(frm, row);\n}\n\nfunction flexi_add_document_buttons(frm) {\n    const rows = frm.doc.custom_customer_documents || [];\n    rows.forEach(row => {\n        const status = row.status || \"Pending\";\n        const icon = status === \"Completed\" ? \"✓\" : \"•\";\n        frm.add_custom_button(\n            __(`${icon} ${flexi_document_title(row)} — ${status}`),\n            () => flexi_open_customer_document(frm, row),\n            __(\"Customer Documents\")\n        );\n    });\n}\n\nfrappe.ui.form.on(\"Loan Application\", {\n    refresh(frm) {\n        if (frm.is_new()) return;\n        flexi_add_document_buttons(frm);\n        if (!frm.__flexi_documents_synced) {\n            frm.__flexi_documents_synced = true;\n            frappe.call({\n                method: \"flexi_document_sync\",\n                args: { docname: frm.doc.name },\n                callback(response) {\n                    if ((response.message || {}).added) frm.reload_doc();\n                }\n            });\n        }\n    }\n});\n/* This block is appended to Flexi Customer Document Signing through fixtures. */\n\nfunction flexi_customer_documents_complete(frm) {\n\treturn (frm.doc.custom_customer_documents || [])\n\t\t.filter((row) => row.document_code !== \"REQ\" && row.document_template !== \"LDT-00007\")\n\t\t.every((row) => [\"Customer Signed\", \"Director Signed\", \"Completed\"].includes(row.status));\n}\n\nfunction flexi_can_open_document(frm, row) {\n\treturn true;\n}\n\nfunction flexi_open_customer_document(frm, row) {\n\tif (row.document_code === \"REQ\" || row.document_template === \"LDT-00007\") return;\n\tif (row.status === \"Completed\" || row.status === \"Director Signed\") {\n\t\tif (row.final_signed_file) window.open(row.final_signed_file, \"_blank\");\n\t\telse frappe.msgprint(__(\"The final signed copy is not available.\"));\n\t\treturn;\n\t}\n\tif (row.status === \"Customer Signed\") {\n\t\tif (!flexi_customer_documents_complete(frm)) {\n\t\t\tfrappe.msgprint(__(\"Complete every customer document before the Director / Manager signs.\"));\n\t\t\treturn;\n\t\t}\n\t\tflexi_open_director_signing(frm, row);\n\t\treturn;\n\t}\n\tflexi_open_customer_signing(frm, row);\n}\n\nfunction flexi_add_document_buttons(frm) {\n\t(frm.doc.custom_customer_documents || [])\n\t\t.filter((row) => row.document_code !== \"REQ\" && row.document_template !== \"LDT-00007\")\n\t\t.forEach((row) => {\n\t\t\tconst status = row.status || \"Pending\";\n\t\t\tconst icon = status === \"Completed\" ? \"✓\" : \"•\";\n\t\t\tfrm.add_custom_button(\n\t\t\t\t__(icon + \" \" + flexi_document_title(row) + \" — \" + status),\n\t\t\t\t() => flexi_open_customer_document(frm, row),\n\t\t\t\t__(\"Customer Documents\")\n\t\t\t);\n\t\t});\n}\n",
