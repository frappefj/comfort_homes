ame,\n    {\n        \"director_name\":\n            director_name,\n\n        \"director_signature\":\n            signature_value,\n\n        \"director_signed_on\":\n            signed_on,\n\n        \"status\":\n            \"Director Signed\"\n    }\n)\n\n\n# ============================================================\n# RELOAD LOAN APPLICATION\n# ============================================================\n\ndoc = frappe.get_doc(\n    \"Loan Application\",\n    docname\n)\n\n\n# ============================================================\n# VALUES REQUIRED BY PRINT FORMAT\n# ============================================================\n\ndoc.hp_account_no = (\n    doc.custom_flexi_hp_account_number\n    or doc.name\n)\n\ndoc.hp_reference_no = (\n    doc.custom_flexi_quotation_number\n    or \"\"\n)\n\ndoc.hirer_signature = (\n    doc.custom_applicant_signature\n    or agreement.customer_signature\n    or \"\"\n)\n\ndoc.hirer_signature_date = (\n    doc.custom_flexi_hirer_signature_date\n    or agreement.customer_signed_on\n)\n\ndoc.company_representative_name = (\n    director_name\n)\n\ndoc.company_representative_signature = (\n    signature_value\n)\n\ndoc.company_representative_date = (\n    signed_date\n)\n\n\n# ============================================================\n# RENDER FINAL AGREEMENT\n#\n# This contains BOTH:\n# customer signature\n# director signature\n# ============================================================\n\nhtml = frappe.get_print(\n    \"Loan Application\",\n    doc.name,\n    print_format=\"Hire Purchase Agreement\",\n    doc=doc\n)\n\n\nif not html:\n    frappe.throw(\n        \"Final signed agreement could not be rendered.\"\n    )\n\n\n# ============================================================\n# CREATE FINAL SIGNED HTML ATTACHMENT\n#\n# wkhtmltopdf is unavailable on this server,\n# therefore we intentionally store the exact signed HTML.\n# ============================================================\n\nfile_name = (\n    doc.name\n    + \"-Hire-Purchase-Agreement-Signed.html\"\n)\n\n\nfile_doc = frappe.get_doc({\n    \"doctype\":\n        \"File\",\n\n    \"file_name\":\n        file_name,\n\n    \"content\":\n        html,\n\n    \"is_private\":\n        1,\n\n    \"attached_to_doctype\":\n        \"Loan Application\",\n\n    \"attached_to_name\":\n        doc.name\n})\n\n\nfile_doc.insert(\n    ignore_permissions=True\n)\n\n\nfile_url = (\n    file_doc.file_url\n)\n\n\nif not file_url:\n    frappe.throw(\n        \"Final signed agreement attachment could not be created.\"\n    )\n\n\n# ============================================================\n# COMPLETE CUSTOMER AGREEMENT\n# ============================================================\n\nfrappe.db.set_value(\n    \"Loan Customer Agreement\",\n    rowname,\n    {\n        \"generated_html\":\n            html,\n\n        \"final_signed_file\":\n            file_url,\n\n        \"director_signed_on\":\n            signed_on,\n\n        \"completed_on\":\n            signed_on,\n\n        \"status\":\n            \"Completed\"\n    }\n)\n\n\n# ============================================================\n# ADD / UPDATE LOAN APPLICATION DOCUMENTS TABLE\n# ============================================================\n\nloan = frappe.get_doc(\n    \"Loan Application\",\n    docname\n)\n\n\ndocument_row = None\n\n\nfor d in loan.documents:\n\n    if (\n        d.document_template == \"LDT-00001\"\n        or d.document_code == \"HP-AGREEMENT\"\n    ):\n        document_row = d\n        break\n\n\nif not document_row:\n\n    document_row = loan.append(\n        \"documents\",\n        {}\n    )\n\n\ndocument_row.document_type = (\n    \"Hire Purchase Agreement\"\n)\n\ndocument_row.file = (\n    file_url\n)\n\ndocument_row.document_template = (\n    \"LDT-00001\"\n)\n\ndocument_row.document_code = (\n    \"HP-AGREEMENT\"\n)\n\ndocument_row.version = (\n    agreement.version or 1\n)\n\ndocument_row.status = (\n    \"Completed\"\n)\n\ndocument_row.generated_on = (\n    agreement.generated_on\n    or signed_on\n)\n\ndocument_row.customer_viewed_on = (\n    agreement.customer_viewed_on\n)\n\ndocument_row.customer_signed_on = (\n    agreement.customer_signed_on\n)\n\ndocument_row.director_signed_on = (\n    signed_on\n)\n\ndocument_row.final_signed_file = (\n    file_url\n)\n\n\nloan.save(\n    ignore_permissions=True\n)\n\n\nfrappe.db.commit()\n\n\nfrappe.response[\"message\"] = {\n    \"status\":\n        \"Completed\",\n\n    \"html\":\n        html,\n\n    \"file_url\":\n        file_url\n}\n",
